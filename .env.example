# =========================================================================
# Public site branding (embedded in built HTML/JS — safe for the public repo)
# Copy to .env and fill in the real values for local dev + prod deploy.
# =========================================================================
PUBLIC_BRAND_NAME=SportsTips
PUBLIC_BRAND_TAGLINE=Sharp Predictions. Proven Results.
PUBLIC_BRAND_DESCRIPTION=Independent football predictions produced by a proprietary consensus engine and verified against real results.
PUBLIC_BRAND_DOMAIN=example.com
PUBLIC_BRAND_URL=https://example.pages.dev
PUBLIC_BRAND_LOCALE=en
PUBLIC_BRAND_EMAIL=info@example.com
PUBLIC_BRAND_TELEGRAM=https://t.me/
PUBLIC_BRAND_TWITTER=#
PUBLIC_BRAND_INSTAGRAM=#
PUBLIC_BRAND_YOUTUBE=#

# Worker API endpoint (published picks + live outcomes). Empty = disabled.
PUBLIC_WORKER_API_URL=

# =========================================================================
# Pipeline / server-side (never sent to browser) — read from .dev.vars for
# local `wrangler dev` and from `wrangler secret put` / GH Secrets in prod.
# =========================================================================
# CF account (public identifier, not a secret, but move to env to keep repo generic)
CLOUDFLARE_ACCOUNT_ID=

# See .dev.vars.example for the full server-side secret list.
