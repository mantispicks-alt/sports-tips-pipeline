---
import '../styles/global.css';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgeGate from '../components/AgeGate.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Crumb { name: string; href: string }
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  breadcrumbs?: Crumb[];
}
const { title, description = SITE.description, noindex = false, ogImage, breadcrumbs } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const shareImage = ogImage ? new URL(ogImage, Astro.site ?? SITE.url).href : new URL('/logo.jpeg', Astro.site ?? SITE.url).href;

const breadcrumbLd = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, Astro.site ?? SITE.url).href,
  })),
} : null;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  logo: new URL('/logo.jpeg', SITE.url).href,
  sameAs: [SITE.telegram, SITE.twitter, SITE.instagram, SITE.youtube].filter((s) => s && s !== '#'),
};

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: { '@type': 'Organization', name: SITE.name },
  inLanguage: SITE.locale,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang={Astro.currentLocale ?? SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {/* hreflang: map every localised route pair so Google serves the right language */}
    {(() => {
      const p = Astro.url.pathname;
      const stripped = p.replace(/^\/el(\/|$)/, '/');
      const enPath = stripped.startsWith('/') ? stripped : `/${stripped}`;
      const elPath = enPath === '/' ? '/el/' : `/el${enPath}`;
      const site = Astro.site ?? new URL(SITE.url);
      return (
        <>
          <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />
          <link rel="alternate" hreflang="el" href={new URL(elPath, site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(enPath, site).href} />
        </>
      );
    })()}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.jpeg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#070b07" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content={(Astro.currentLocale ?? SITE.locale) === 'el' ? 'el_CY' : 'en_GB'} />
    <meta property="og:locale:alternate" content={(Astro.currentLocale ?? SITE.locale) === 'el' ? 'en_GB' : 'el_CY'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="rating" content="adult" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="bg-black/60 text-center py-1.5 px-3 border-b border-slate-800/60">
      <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-slate-500">
        <span class="text-brand-400">{SITE.minAge}+</span> ·
        {(Astro.currentLocale ?? SITE.locale) === 'el'
          ? ' Παίξτε υπεύθυνα · ποτέ πάνω από όσα μπορείτε να χάσετε'
          : ' Gamble Responsibly · never stake more than you can afford to lose'}
      </span>
    </div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <AgeGate />
    <CookieConsent />
    <script is:inline define:vars={{ WORKER_API_URL: SITE.workerApiUrl }}>
      // Auto-refresh: the tips pipeline redeploys ~every 2h. Poll a tiny,
      // never-cached build stamp and reload the tab when it changes — on an
      // interval and whenever the tab regains focus — so a page left open stays
      // current on its own. Reloads only on a real change (never on first read).
      (() => {
        let baseline = null;
        const read = async () => {
          try {
            const r = await fetch('/version.json?_=' + Date.now(), { cache: 'no-store' });
            if (!r.ok) return null;
            return (await r.json()).build;
          } catch (_) { return null; }
        };
        const check = async () => {
          const v = await read();
          if (v == null) return;
          if (baseline == null) { baseline = v; return; }
          if (v !== baseline) location.reload();
        };
        check();
        setInterval(() => { if (document.visibilityState === 'visible') check(); }, 180000);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') check();
        });
      })();

      // Live outcomes: fetch the Worker's /api/outcomes every 5 min and update
      // any WON/LOST badge whose match has settled since the last static build.
      // Closes the gap between the 5-min settlement pass (CF Worker → D1) and
      // the 2h site rebuild — a match finished at 22:00 shows its result on
      // this open tab by 22:05, without a reload. Ignores locked (paid-only)
      // cards to preserve the funnel; those catch up at the next rebuild.
      (() => {
        const WORKER = WORKER_API_URL;
        if (!WORKER) return;
        const RESULT_STYLE = {
          pending: 'bg-slate-700/40 text-slate-300 border-slate-600/50',
          won: 'bg-brand-500/15 text-brand-400 border-brand-500/50',
          lost: 'bg-rose-500/15 text-rose-400 border-rose-500/50',
          void: 'bg-amber-500/15 text-amber-400 border-amber-500/50',
        };
        const BADGE_CLS = 'font-mono text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md border';
        // Normalise a market or selection string to a compact form so the D1
        // side ("1x2", "home") and the content side ("Match Result 1X2",
        // "Home Win") still hash the same. Cheap heuristic — market group
        // detection + first meaningful word — enough for the common cases.
        const norm = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 40);
        const pull = async () => {
          try {
            const r = await fetch(WORKER + '/api/outcomes?days=3', { cache: 'no-store' });
            if (!r.ok) return;
            const data = await r.json();
            if (!Array.isArray(data)) return;
            const byMatch = new Map();
            for (const o of data) {
              if (!o?.matchKey || !o?.result) continue;
              const bucket = byMatch.get(o.matchKey) || [];
              bucket.push(o);
              byMatch.set(o.matchKey, bucket);
            }
            for (const card of document.querySelectorAll('[data-live-pick][data-result="pending"]')) {
              const mk = card.getAttribute('data-matchkey');
              if (!mk) continue;
              const bucket = byMatch.get(mk);
              if (!bucket || !bucket.length) continue;
              const cardMkt = norm(card.getAttribute('data-market'));
              const cardSel = norm(card.getAttribute('data-selection'));
              const match = bucket.find((o) => norm(o.market) === cardMkt && norm(o.selection) === cardSel) || bucket[0];
              const result = match.result;
              if (!RESULT_STYLE[result]) continue;
              card.setAttribute('data-result', result);
              const badge = card.querySelector('[data-result-badge]');
              if (badge) {
                badge.className = BADGE_CLS + ' ' + RESULT_STYLE[result];
                badge.textContent = result;
              }
            }
          } catch (_) {}
        };
        // Only run on pages that actually render tip cards.
        if (document.querySelector('[data-live-pick]')) {
          pull();
          setInterval(() => { if (document.visibilityState === 'visible') pull(); }, 300000);
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') pull();
          });
        }
      })();
    </script>
  </body>
</html>
