---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { dedupeByMatch } from '../lib/dedupe';

// Build an index of the searchable content — tips, articles, bookmakers, experts.
// The page ships as static HTML; a small client script filters in-place.
const tips = dedupeByMatch(await getCollection('tips')).map((t) => ({
  kind: 'Tip',
  title: t.data.match,
  desc: `${t.data.league} · ${t.data.market} · ${t.data.pick} @ ${t.data.odds}`,
  href: `/tips/${t.id}`,
  q: `${t.data.match} ${t.data.league} ${t.data.market} ${t.data.pick} ${t.data.sport}`.toLowerCase(),
}));
const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .map((a) => ({
    kind: 'Article',
    title: a.data.title,
    desc: a.data.description,
    href: `/news/${a.id}`,
    q: `${a.data.title} ${a.data.description} ${a.data.sport}`.toLowerCase(),
  }));
const bookmakers = (await getCollection('bookmakers')).map((b) => ({
  kind: 'Bookmaker',
  title: b.data.name,
  desc: b.data.bonus ?? '',
  href: `/bookmakers/${b.id}`,
  q: `${b.data.name} ${b.data.bonus ?? ''}`.toLowerCase(),
}));
const experts = (await getCollection('authors')).map((a) => ({
  kind: 'Expert',
  title: a.data.name,
  desc: a.data.role,
  href: `/experts/${a.id}`,
  q: `${a.data.name} ${a.data.role} ${(a.data.expertise ?? []).join(' ')}`.toLowerCase(),
}));
const index = [...tips, ...articles, ...bookmakers, ...experts];
---

<Base
  title="Search"
  description="Search the site — predictions, articles, bookmaker reviews and experts."
  noindex={true}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Search', href: '/search' }]}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Search</h1>
    <p class="text-slate-400 mt-2">Find predictions, articles, bookmakers or experts.</p>

    <form class="mt-6" role="search" data-search>
      <input
        type="search"
        name="q"
        placeholder="Search picks, leagues, teams, bookmakers…"
        aria-label="Search"
        autocomplete="off"
        class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white placeholder:text-slate-600 focus:border-brand-500 outline-none transition"
      />
    </form>

    <div id="searchResults" class="mt-8 space-y-3"></div>
    <p id="searchEmpty" class="mt-8 text-sm text-slate-500 hidden">No matches. Try broader terms — team name, league, or bookmaker.</p>
  </section>

  <script type="application/json" id="searchIndex" set:html={JSON.stringify(index)}></script>

  <script>
    const raw = document.getElementById('searchIndex')?.textContent ?? '[]';
    const idx: Array<{ kind: string; title: string; desc: string; href: string; q: string }> = JSON.parse(raw);
    const input = document.querySelector<HTMLInputElement>('input[name="q"]');
    const out = document.getElementById('searchResults');
    const empty = document.getElementById('searchEmpty');

    // Hydrate from ?q= if present, so a link like /search?q=arsenal works.
    const params = new URLSearchParams(location.search);
    const seed = params.get('q') ?? '';
    if (input && seed) input.value = seed;

    const render = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      if (!out) return;
      out.innerHTML = '';
      if (empty) empty.classList.add('hidden');
      if (!q) return;
      const hits = idx.filter((r) => r.q.includes(q)).slice(0, 40);
      if (hits.length === 0) {
        if (empty) empty.classList.remove('hidden');
        return;
      }
      out.innerHTML = hits.map((h) => `
        <a href="${h.href}" class="block card rounded-xl p-4 hover:border-brand-500 transition">
          <div class="text-[10px] uppercase tracking-wide text-brand-400 font-mono">${h.kind}</div>
          <div class="text-white font-semibold mt-1">${h.title}</div>
          <div class="text-sm text-slate-400 mt-0.5">${h.desc}</div>
        </a>
      `).join('');
    };

    input?.addEventListener('input', render);
    render();
  </script>
</Base>
