---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dedupeByMatch } from '../../lib/dedupe';

const raw = dedupeByMatch(await getCollection('tips'));
const settled = raw.filter((t) => ['won', 'lost', 'void'].includes(t.data.result));
const won = settled.filter((t) => t.data.result === 'won').length;
const lost = settled.filter((t) => t.data.result === 'lost').length;
const voidTips = settled.filter((t) => t.data.result === 'void').length;
const winRate = won + lost > 0 ? Math.round((won / (won + lost)) * 100) : 0;
const profit = settled.reduce((s, t) =>
  s + (t.data.result === 'won' ? Math.round((t.data.odds - 1) * 100) / 100
       : t.data.result === 'lost' ? -1 : 0), 0);
const roi = won + lost > 0 ? Math.round((profit / (won + lost)) * 1000) / 10 : 0;

const bands = [
  { key: 'WIN',     name: 'WIN — Favorites ≤ 1.80',   test: (o: number) => o <= 1.80 },
  { key: 'OVERALL', name: 'OVERALL — Value 2.60–3.49', test: (o: number) => o >= 2.60 && o < 3.50 },
  { key: 'ROI',     name: 'ROI — High value ≥ 3.50',   test: (o: number) => o >= 3.50 },
];

const bandStats = bands.map((b) => {
  const list = settled.filter((t) => b.test(t.data.odds));
  const w = list.filter((t) => t.data.result === 'won').length;
  const l = list.filter((t) => t.data.result === 'lost').length;
  const wr = w + l ? Math.round((w / (w + l)) * 100) : 0;
  const p = list.reduce((s, t) =>
    s + (t.data.result === 'won' ? Math.round((t.data.odds - 1) * 100) / 100
         : t.data.result === 'lost' ? -1 : 0), 0);
  const r = w + l ? Math.round((p / (w + l)) * 1000) / 10 : 0;
  return { ...b, total: list.length, won: w, lost: l, winRate: wr, roi: r };
});

const fmt = (d: Date) => new Intl.DateTimeFormat('el-CY', { day: '2-digit', month: 'short' }).format(d);
---

<Base title="Αποτελέσματα & Απόδοση" description="Τρία tracked systems — WIN, OVERALL και ROI — καθένα με πραγματικό win rate, ROI, κέρδος και πλήρες ιστορικό. Καμία επιλεκτικότητα.">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Αποτελέσματα & Απόδοση</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">
      Τρία συστήματα, tracked ξεχωριστά. Κάθε settled tip καταγράφεται με flat 1-unit στοιχήματα — καλά και κακά.
    </p>

    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="card rounded-xl px-4 py-3">
        <p class="hud hud-dim">Settled</p>
        <p class="mt-1 font-mono text-xl font-bold text-white">{settled.length}</p>
      </div>
      <div class="card rounded-xl px-4 py-3">
        <p class="hud hud-dim">Win rate</p>
        <p class="mt-1 font-mono text-xl font-bold text-white">{winRate}%</p>
      </div>
      <div class="card rounded-xl px-4 py-3">
        <p class="hud hud-dim">ROI</p>
        <p class:list={['mt-1 font-mono text-xl font-bold', roi >= 0 ? 'text-brand-400' : 'text-rose-400']}>{roi >= 0 ? '+' : ''}{roi}%</p>
      </div>
      <div class="card rounded-xl px-4 py-3">
        <p class="hud hud-dim">Κέρδος (u)</p>
        <p class:list={['mt-1 font-mono text-xl font-bold', profit >= 0 ? 'text-brand-400' : 'text-rose-400']}>{profit >= 0 ? '+' : ''}{profit}u</p>
      </div>
    </div>

    <h2 class="mt-12 font-display text-2xl font-black text-white">Οι τρεις μπάντες αποδόσεων</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {bandStats.map((b) => (
        <div class="card rounded-2xl p-5">
          <p class="hud text-brand-400">{b.key}</p>
          <p class="mt-1 font-display text-lg font-bold text-white">{b.name}</p>
          <div class="mt-4 grid grid-cols-3 gap-2 text-center text-sm">
            <div><p class="text-[10px] uppercase text-slate-500">Total</p><p class="mt-0.5 font-mono font-bold text-white">{b.total}</p></div>
            <div><p class="text-[10px] uppercase text-slate-500">WR</p><p class="mt-0.5 font-mono font-bold text-white">{b.winRate}%</p></div>
            <div><p class="text-[10px] uppercase text-slate-500">ROI</p><p class:list={['mt-0.5 font-mono font-bold', b.roi >= 0 ? 'text-brand-400' : 'text-rose-400']}>{b.roi >= 0 ? '+' : ''}{b.roi}%</p></div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-10 text-xs text-slate-500 leading-relaxed">
      Το ιστορικό είναι δημόσιο και διατηρείται από την ημερομηνία GENESIS. Οι δοκιμαστικές αλλαγές αρχειοθετούνται ξεχωριστά ώστε καμιά αλλαγή κανόνων να μη ξαναγράφει σιωπηλά ιστορικό. Τα αποτελέσματα παρελθόντος δεν εγγυώνται μελλοντικά κέρδη.
    </p>
  </section>
</Base>
