---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Mascot from '../../components/Mascot.astro';
import { SITE } from '../../config';
import { computeResults } from '../../lib/results';
import { dedupeByMatch } from '../../lib/dedupe';

const allTips = dedupeByMatch(await getCollection('tips'));
const r = computeResults(allTips);
const hasRecord = r.settled > 0;

const STATS = hasRecord
  ? [
      { k: 'Win rate', v: `${r.winRate}%` },
      { k: 'ROI', v: `${r.roi >= 0 ? '+' : ''}${r.roi}%` },
      { k: 'Settled', v: `${r.settled}` },
      { k: 'Avg odds', v: r.avgOdds.toFixed(2) },
    ]
  : [
      { k: 'Μηχανή', v: 'Ιδιόκτητη' },
      { k: 'Άθλημα', v: 'Ποδόσφαιρο' },
      { k: 'Αποτελέσματα', v: 'Δημόσια' },
      { k: 'Δωρεάν pick', v: 'Καθημερινό' },
    ];
---

<Base
  title="the site — Έξυπνες Προβλέψεις Ποδοσφαίρου"
  description="Δωρεάν καθημερινές προβλέψεις ποδοσφαίρου από ανεξάρτητη μηχανή consensus. Πλήρες δημόσιο ιστορικό, καμία απόκρυψη ηττών. 18+ · παίξτε υπεύθυνα."
>
  <section class="relative overflow-hidden border-b border-slate-800/60">
    <div class="pointer-events-none absolute inset-0 grid-scan opacity-80"></div>

    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-14 md:pt-24 md:pb-20 grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      <div class="lg:col-span-7">
        <Mascot size={120} glow class="mb-6 lg:hidden rise" />
        <span class="hud inline-flex items-center gap-2 rise">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 live-dot"></span>
          Ζωντανές // προβλέψεις με δεδομένα
        </span>

        <h1 class="mt-5 font-display text-5xl md:text-7xl font-black text-white leading-[0.95] rise">
          Η αγορά ανοιγοκλείνει.<br />
          <span class="text-brand-400 text-glow">Εμείς χτυπάμε.</span>
        </h1>

        <p class="mt-6 text-lg text-slate-300 max-w-xl rise">
          Δωρεάν καθημερινό pick ποδοσφαίρου, καθώς και premium picks με την ισχυρότερη ελεγμένη βάση. Κάθε δημοσιευμένο pick καταγράφεται δημόσια — νίκες και ήττες, χωρίς επιλεκτικότητα.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3 rise">
          <a href="/el/tips" class="font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl transition glow">
            Δες τα σημερινά picks →
          </a>
          <a href="/el/results" class="font-semibold text-gold border border-gold/40 hover:bg-gold/10 px-6 py-3 rounded-xl transition">
            Ιστορικό αποτελεσμάτων
          </a>
        </div>

        <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3 rise">
          {STATS.map((s) => (
            <div class="card rounded-xl px-4 py-3">
              <p class="hud hud-dim">{s.k}</p>
              <p class="mt-1 font-mono text-xl md:text-2xl font-bold text-white">{s.v}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5 rise">
        <div class="relative card card-gold rounded-3xl p-5 sm:p-6 reticle overflow-hidden">
          <div class="relative text-center py-6">
            <p class="hud text-gold">Σήμερα</p>
            <h2 class="mt-4 font-display text-3xl font-black text-white">Το free pick της ημέρας</h2>
            <p class="mt-3 text-slate-300">Δες το χωρίς εγγραφή στη σελίδα προβλέψεων.</p>
            <a href="/el/tips" class="mt-6 inline-flex font-bold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-xl px-6 py-3 transition">
              Άνοιγμα picks →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20 border-t border-slate-800/60">
    <div class="text-center">
      <p class="hud">Γιατί the site</p>
      <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Υπομονή. Ακρίβεια. Απόδειξη.</h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <div class="card rounded-2xl p-6">
        <p class="font-display text-xl font-bold text-white">Ιδιόκτητη μηχανή consensus</p>
        <p class="mt-2 text-slate-400 text-sm">Πολλαπλά ανεξάρτητα σήματα διασταυρώνονται σε κάθε κύκλο. Ένα pick δημοσιεύεται μόνο όταν αυστηροί κανόνες audit ικανοποιούνται.</p>
      </div>
      <div class="card card-gold rounded-2xl p-6">
        <p class="font-display text-xl font-bold text-white">Καταγραμμένα αποτελέσματα</p>
        <p class="mt-2 text-slate-400 text-sm">Δημόσιο win rate, ROI και καμπύλη κέρδους. Νίκες και ήττες — τίποτα δεν σβήνεται.</p>
      </div>
      <div class="card rounded-2xl p-6">
        <p class="font-display text-xl font-bold text-white">Μόνο αδειοδοτημένα</p>
        <p class="mt-2 text-slate-400 text-sm">Προτείνουμε μόνο bonuses από αδειοδοτημένους & αξιόπιστους παρόχους. Καμία ύποπτη εταιρεία.</p>
      </div>
    </div>
    <div class="mt-8 text-center">
      <a href="/el/pricing" class="inline-block font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-xl px-6 py-3 transition">
        Πλάνα συνδρομής →
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4">
    <div class="rounded-2xl border border-slate-800/70 bg-slate-900/50 p-5 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-wider text-brand-400">{SITE.minAge}+ Only</p>
        <p class="mt-1 text-xs text-slate-400">Επαλήθευση ηλικίας σε κάθε επίσκεψη</p>
      </div>
      <div>
        <p class="font-mono text-[10px] uppercase tracking-wider text-brand-400">Αδειοδοτημένοι</p>
        <p class="mt-1 text-xs text-slate-400">Μόνο EU/UK/CY ρυθμιζόμενοι bookmakers</p>
      </div>
      <div>
        <p class="font-mono text-[10px] uppercase tracking-wider text-brand-400">GDPR Compliant</p>
        <p class="mt-1 text-xs text-slate-400">Δεδομένα επεξεργάζονται εντός EU</p>
      </div>
      <div>
        <p class="font-mono text-[10px] uppercase tracking-wider text-brand-400">Έδρα Κύπρος</p>
        <p class="mt-1 text-xs text-slate-400">Κυπριακό δίκαιο</p>
      </div>
    </div>
  </section>

  <p class="text-center text-[11px] text-slate-500 pb-10 pt-10">
    {SITE.minAge}+ · Παίξτε υπεύθυνα · Στοιχηματίστε μόνο όσα μπορείτε να χάσετε
  </p>
</Base>
