---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dedupeByMatch } from '../../lib/dedupe';

const tips = dedupeByMatch(await getCollection('tips'));
const now = Date.now();

const counts = new Map<string, { upcoming: number; total: number; won: number; lost: number }>();
for (const t of tips) {
  const key = t.data.league || 'Unknown';
  const row = counts.get(key) ?? { upcoming: 0, total: 0, won: 0, lost: 0 };
  row.total++;
  if (t.data.result === 'pending' && +t.data.kickoff > now) row.upcoming++;
  if (t.data.result === 'won') row.won++;
  if (t.data.result === 'lost') row.lost++;
  counts.set(key, row);
}
const leagues = [...counts.entries()]
  .filter(([name]) => name && name !== 'Unknown' && name !== 'Various')
  .sort((a, b) => (b[1].upcoming - a[1].upcoming) || (b[1].total - a[1].total));

import { LEAGUE_HUBS } from '../../lib/leagues';
function leagueHref(name: string): string {
  const hub = LEAGUE_HUBS.find((h) => h.aliases.some((a) => a.toLowerCase() === name.trim().toLowerCase()));
  return hub ? `/el/leagues/${hub.slug}` : `/search?q=${encodeURIComponent(name)}`;
}
---

<Base title="Προβλέψεις ανά Λίγκα" description="Προβλέψεις ποδοσφαίρου οργανωμένες ανά λίγκα — Premier League, La Liga, Serie A, Bundesliga, Champions League και 500+ διοργανώσεις.">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Προβλέψεις ανά Λίγκα</h1>
    <p class="mt-2 text-slate-400 max-w-2xl">
      Κάθε λίγκα για την οποία έχουμε δημοσιεύσει pick, ταξινομημένη με βάση τα upcoming matches. {leagues.length} διοργανώσεις.
    </p>

    <div class="mt-6">
      <input type="search" id="leagueFilter" placeholder="Φιλτράρισμα..." aria-label="Filter leagues" autocomplete="off" class="w-full max-w-md rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white placeholder:text-slate-600 focus:border-brand-500 outline-none transition" />
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" id="leagueGrid">
      {leagues.map(([name, r]) => {
        const rate = r.won + r.lost > 0 ? Math.round((r.won / (r.won + r.lost)) * 100) : null;
        return (
          <a href={leagueHref(name)} class="league-item card rounded-xl p-4 hover:border-brand-500 transition group" data-name={name.toLowerCase()}>
            <div class="font-semibold text-white group-hover:text-brand-400 transition">{name}</div>
            <div class="mt-1 text-xs text-slate-400 flex flex-wrap gap-x-3 gap-y-0.5">
              {r.upcoming > 0 && <span class="text-brand-400">{r.upcoming} upcoming</span>}
              <span>{r.total} σύνολο</span>
              {rate !== null && <span>{rate}% WR</span>}
            </div>
          </a>
        );
      })}
    </div>

    <p id="leagueEmpty" class="mt-8 text-sm text-slate-500 hidden">Καμία λίγκα δεν ταιριάζει.</p>
  </section>

  <script>
    const input = document.getElementById('leagueFilter') as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLAnchorElement>('.league-item');
    const empty = document.getElementById('leagueEmpty');
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((el) => {
        const match = !q || (el.dataset.name || '').includes(q);
        el.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    });
  </script>
</Base>
