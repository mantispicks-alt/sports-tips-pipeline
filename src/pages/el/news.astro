---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Νέα & Ανάλυση Στοιχήματος" description="Οδηγοί στρατηγικής, previews αγώνων και αναλύσεις από την ομάδα the site." breadcrumbs={[{ name: 'Αρχική', href: '/el/' }, { name: 'Νέα', href: '/el/news' }]}>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Νέα & Ανάλυση</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">
      Οδηγοί στρατηγικής, previews αγώνων και αναλύσεις — δωρεάν, χωρίς εγγραφή.
    </p>

    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((entry) => (<ArticleCard entry={entry} />))}
    </div>
    {articles.length === 0 && (
      <div class="mt-8 card rounded-xl p-6 text-slate-400 text-sm">Δεν υπάρχουν άρθρα ακόμη.</div>
    )}
  </section>
</Base>
