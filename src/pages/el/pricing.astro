---
import Base from '../../layouts/Base.astro';
import Mascot from '../../components/Mascot.astro';
import { SITE, TIERS, BILLING } from '../../config';

const ctaHref = (id: string) => (id === 'free' ? '/el/tips' : SITE.telegram);

const TIER_TAGLINES: Record<string, string> = {
  free: 'Δες πόσο ακριβείς είμαστε.',
  win: 'Το υψηλότερο strike rate. Ξεκούραστο.',
  premium: 'Ισορροπία win rate και κέρδους.',
  vip: 'Μέγιστο return. Η μηχανή value.',
};
const TIER_CTA: Record<string, string> = {
  free: 'Ξεκίνα δωρεάν',
  win: 'Πάρε WIN',
  premium: 'Πάρε OVERALL',
  vip: 'Πάρε VIP',
};

const faqs = [
  {
    q: 'Πώς παραδίδονται τα picks;',
    a: 'Τα δωρεάν picks βρίσκονται στη σελίδα κάθε μέρα. Το Premium ξεκλειδώνει όλα τα δημοσιευμένα picks — πλήρη ανάλυση, market, επιλογή, odds. Το VIP προσθέτει τα picks με τη μεγαλύτερη ελεγμένη βεβαιότητα και ιδιωτικό Telegram κανάλι.',
  },
  {
    q: 'Εγγυάστε νίκες;',
    a: 'Κανένας ειλικρινής πάροχος δεν το κάνει. Έχουμε ιδιόκτητη μηχανή consensus και δημοσιεύουμε κάθε αποτέλεσμα — νίκες και ήττες. Σε βάθος σεζόν το edge φαίνεται στο ROI, όχι σε μεμονωμένο pick.',
  },
  {
    q: 'Μπορώ να ακυρώσω οποτεδήποτε;',
    a: 'Ναι. Η συνδρομή είναι μηνιαία — ακυρώνεις με ένα κλικ και κρατάς την πρόσβαση μέχρι το τέλος της περιόδου. Καμία δέσμευση, καμία χρέωση.',
  },
  {
    q: 'Ποια αθλήματα καλύπτονται;',
    a: 'Κυρίως ποδόσφαιρο — όλες οι μεγάλες ευρωπαϊκές λίγκες, κύπελλα, διεθνείς διοργανώσεις και εκατοντάδες μικρότερα markets.',
  },
];
---

<Base
  title="Συνδρομή VIP & Τιμές"
  description="Ξεκλείδωσε κάθε πρόβλεψη the site και τα VIP high-confidence picks. Free, Premium και VIP πλάνα — ακύρωσε οποτεδήποτε."
>
  <section class="relative overflow-hidden border-b border-slate-800/60">
    <div class="pointer-events-none absolute inset-0 grid-scan opacity-70"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-10 md:pt-20 text-center">
      <div class="flex justify-center"><Mascot size={190} /></div>
      <p class="mt-4 hud">Συνδρομή // διάλεξε το edge σου</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-black text-white leading-[1.0]">
        Στοιχημάτισε με ολόκληρο το <span class="text-brand-400 text-glow">οπλοστάσιο</span>.
      </h1>
      <p class="mt-5 text-lg text-slate-300 max-w-2xl mx-auto">
        Ξεκίνα δωρεάν και δες το ιστορικό μόνος σου. Αναβάθμισε όταν θες κάθε pick, την πλήρη ανάλυση και τα πιο δυνατά strikes. Ακύρωση με ένα κλικ.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 -mt-2 pb-8 md:pb-12">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4 items-start">
      {TIERS.map((tier) => (
        <div class:list={['relative rounded-3xl p-6 md:p-7 flex flex-col', tier.highlight ? 'card card-gold glow-gold lg:-mt-4 lg:mb-4' : 'card']}>
          <div class="flex items-center justify-between gap-3">
            <h2 class="font-display text-2xl font-black text-white">{tier.name}</h2>
            {tier.badge && (
              <span class:list={['font-mono text-[10px] uppercase tracking-wider font-bold px-2.5 py-1 rounded-full border', tier.highlight ? 'text-gold border-gold/50 bg-gold/10' : 'text-brand-400 border-brand-500/40 bg-brand-500/10']}>{tier.badge}</span>
            )}
          </div>
          <p class="mt-1 text-sm text-slate-400">{TIER_TAGLINES[tier.id] ?? tier.tagline}</p>

          <div class="mt-5 flex items-end gap-1.5">
            <span class="font-display text-5xl font-black text-white">{tier.price === 0 ? '€0' : `${BILLING.currency}${tier.price}`}</span>
            <span class="mb-1.5 font-mono text-xs text-slate-500">/ {tier.period === 'forever' ? 'πάντα' : 'μήνα'}</span>
          </div>

          <a href={ctaHref(tier.id)} class:list={['mt-6 block text-center font-bold rounded-xl py-3 transition', tier.id === 'free' ? 'text-white border border-slate-700 hover:border-brand-500' : 'text-slate-950 bg-brand-500 hover:bg-brand-400 glow']}>
            {TIER_CTA[tier.id] ?? tier.cta} →
          </a>

          <ul class="mt-6 space-y-3">
            {tier.features.map((f) => (
              <li class="flex items-start gap-2.5 text-sm">
                <span class:list={['mt-0.5 shrink-0 grid place-items-center w-4 h-[18px] hex', f.included ? 'bg-brand-500/20 text-brand-400' : 'bg-slate-800 text-slate-600']}>
                  <svg viewBox="0 0 24 24" class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3">
                    {f.included ? <path d="M5 12.5l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/> : <path d="M6 12h12" stroke-linecap="round"/>}
                  </svg>
                </span>
                <span class:list={[f.included ? 'text-slate-200' : 'text-slate-500']}>{f.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    {!BILLING.live && (
      <p class="mt-6 text-center font-mono text-[11px] tracking-wide text-slate-500">
        Το ασφαλές checkout με κάρτα ξεκινά σύντομα · ξεκίνα δωρεάν σήμερα · {SITE.minAge}+ · παίξτε υπεύθυνα
      </p>
    )}
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <p class="hud text-center">FAQ</p>
    <h2 class="mt-2 text-center font-display text-3xl font-black text-white">Πριν αναβαθμίσεις</h2>
    <div class="mt-8 space-y-3">
      {faqs.map((f) => (
        <details class="card rounded-2xl px-5 py-4 group">
          <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-white">
            <span>{f.q}</span>
            <span class="text-brand-400 text-xl leading-none shrink-0 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-sm text-slate-400 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
