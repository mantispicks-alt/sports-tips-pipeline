---
// Admin-only payments tracker — not linked from the site, excluded from
// sitemap by astro.config.mjs's `!/\/admin(-|\/|$)/` filter. Direct-URL only.
// Numbers live in a plain data literal below; edit here to keep the truth.
import Base from '../../layouts/Base.astro';

const services = [
  {
    name: 'DigitalOcean droplet (the-site)',
    cost: 12,
    unit: 'μήνα',
    status: 'idle',
    detail: 'Cron killed. Ready to destroy. No pipeline runs on it.',
    manage: 'https://cloud.digitalocean.com/droplets',
    action: 'Destroy for -$12/mo',
  },
  {
    name: 'GitHub Actions (private repo overage)',
    cost: 1.30,
    unit: 'μήνα',
    status: 'active',
    detail: '2160 min/μήνα usage on 2000 free tier. Overage $0.008/min.',
    manage: 'https://github.com/settings/billing',
  },
  {
    name: 'Cloudflare Workers Paid',
    cost: 5,
    unit: 'μήνα',
    status: 'active',
    detail: 'Powers CF Worker (5-min settlement) + Workers AI (FREE LLM).',
    manage: 'https://dash.cloudflare.com',
  },
  {
    name: 'api-football Pro',
    cost: 19,
    unit: 'μήνα',
    status: 'active',
    detail: '7500 req/day. Expires 2026-10-18. Essential for fixtures + results.',
    manage: 'https://dashboard.api-football.com',
    used_today: '~230 / 7500 req',
  },
  {
    name: 'Highlightly BASIC',
    cost: 10,
    unit: 'μήνα (approx)',
    status: 'quota-limited today',
    detail: 'Odds + fixtures across 950+ leagues. Quota exhausted today from testing.',
    manage: 'https://highlightly.net/dashboard',
    action: 'Upgrade PRO $9.49/mo → 7500 req/day if daily quota hits',
  },
  {
    name: 'The Odds API',
    cost: 0,
    unit: 'FREE (5 keys × 500 credits)',
    status: 'active',
    detail: 'Sharp value engine — 2500 credits/μήνα combined. Usage ~1800/μήνα.',
    manage: 'https://the-odds-api.com',
  },
  {
    name: 'Bzzoiro (BSD)',
    cost: 0,
    unit: 'FREE',
    status: 'active',
    detail: 'De-vigged market odds for 48 leagues (1X2/OU/BTTS).',
    manage: 'https://sports.bzzoiro.com',
  },
  {
    name: 'Tavily (web search)',
    cost: 0,
    unit: 'FREE (rotating keys)',
    status: 'unused',
    detail: 'Settlement web-search fallback (SETTLE_USE_WEB=0 by default).',
    manage: 'https://tavily.com',
  },
  {
    name: 'OpenAI',
    cost: 0,
    unit: 'pay-per-use (unused now)',
    status: 'fallback only',
    detail: 'LLM fallback if workers-ai fails. Zero cost since workers-ai works.',
    manage: 'https://platform.openai.com',
  },
  {
    name: 'football-data.org',
    cost: 0,
    unit: 'FREE',
    status: 'rate-limited',
    detail: 'Historical results backup. 10 req/min. Regularly hits 429.',
    manage: 'https://football-data.org',
  },
  {
    name: 'odds-api.io',
    cost: 0,
    unit: 'FREE (100/hour)',
    status: 'active',
    detail: 'Fixtures fallback + settlement resolver. Runs on deep passes.',
    manage: 'https://odds-api.io',
  },
];

const paid = services.filter((s) => s.cost > 0);
const free = services.filter((s) => s.cost === 0);
const totalPaid = paid.reduce((sum, s) => sum + s.cost, 0);
const totalAfterDoDestroy = totalPaid - 12;

const fmtCost = (c: number) => c === 0 ? 'FREE' : `$${c.toFixed(2)}`;
---

<Base title="Admin — Payments" description="Internal">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <header class="mb-8">
      <p class="text-xs uppercase tracking-wider text-slate-500">Admin</p>
      <h1 class="font-display text-3xl font-bold text-white">Payments Tracker</h1>
      <p class="text-slate-400 text-sm mt-2">Sensitive — not indexed, not linked. Direct URL only.</p>
    </header>

    <section class="mb-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="card rounded-xl p-5 border border-slate-700">
        <p class="hud hud-dim">Total /μήνα (now)</p>
        <p class="font-mono text-3xl font-bold text-white mt-1">${totalPaid.toFixed(2)}</p>
      </div>
      <div class="card rounded-xl p-5 border border-brand-500/40">
        <p class="hud hud-dim">After DO destroy</p>
        <p class="font-mono text-3xl font-bold text-brand-400 mt-1">${totalAfterDoDestroy.toFixed(2)}</p>
      </div>
      <div class="card rounded-xl p-5 border border-slate-700">
        <p class="hud hud-dim">Free services</p>
        <p class="font-mono text-3xl font-bold text-white mt-1">{free.length}</p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="font-display text-xl font-bold text-white mb-4">💳 Paid ({paid.length})</h2>
      <div class="space-y-3">
        {paid.map((s) => (
          <div class="card rounded-lg p-4 border border-slate-700 hover:border-brand-500/40 transition">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-display font-bold text-white">{s.name}</h3>
                  <span class:list={[
                    'text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md border',
                    s.status === 'active' && 'text-brand-400 border-brand-500/50 bg-brand-500/10',
                    s.status === 'idle' && 'text-amber-400 border-amber-500/50 bg-amber-500/10',
                    s.status && s.status.includes('quota') && 'text-rose-400 border-rose-500/50 bg-rose-500/10',
                  ]}>{s.status}</span>
                </div>
                <p class="text-slate-400 text-sm mt-1">{s.detail}</p>
                {s.action && <p class="text-amber-400 text-xs mt-1 font-mono">⚠ {s.action}</p>}
                {s.used_today && <p class="text-slate-500 text-xs mt-1 font-mono">📊 {s.used_today}</p>}
              </div>
              <div class="text-right shrink-0">
                <p class="font-mono text-xl font-bold text-white">{fmtCost(s.cost)}</p>
                <p class="text-xs text-slate-500">{s.unit}</p>
                <a href={s.manage} target="_blank" rel="noopener" class="mt-2 inline-block text-xs text-brand-400 hover:text-brand-300">Manage →</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="font-display text-xl font-bold text-white mb-4">🆓 Free ({free.length})</h2>
      <div class="space-y-3">
        {free.map((s) => (
          <div class="card rounded-lg p-4 border border-slate-800">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-display font-bold text-white">{s.name}</h3>
                  <span class="text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md border text-slate-400 border-slate-600/50 bg-slate-700/30">{s.status}</span>
                </div>
                <p class="text-slate-400 text-sm mt-1">{s.detail}</p>
              </div>
              <div class="text-right shrink-0">
                <p class="text-xs text-slate-500">{s.unit}</p>
                <a href={s.manage} target="_blank" rel="noopener" class="mt-2 inline-block text-xs text-brand-400 hover:text-brand-300">Manage →</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <footer class="mt-10 text-xs text-slate-500 font-mono">
      <p>Last audit: 2026-09-28 · Numbers editable in src/pages/admin/payments.astro</p>
    </footer>
  </main>
</Base>
