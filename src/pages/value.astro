---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import ValueCard from '../components/ValueCard.astro';
import { SITE } from '../config';
import { buildValueFeed } from '../lib/valueFeed';
import valuePicksRaw from '../data/tips/odds-value.json';

const tips = await getCollection('tips');
const picks = buildValueFeed({ sharpRaw: valuePicksRaw as any[], tips, limit: 24 });

const STEPS = [
  { n: '01', t: 'Fair market probability', d: 'Every fixture has a market-implied probability once margins are stripped. That is the closest thing to the real number a fixture has, and it is the reference every value calculation runs against.' },
  { n: '02', t: 'Scan every book', d: 'We compare that fair price against the best odds every other bookmaker is offering on the same selection, live.' },
  { n: '03', t: 'Only +EV survives', d: 'When a book pays more than the market-fair price, that gap is genuine value (+EV). Those — and only those — are published here.' },
];
---

<Base
  title="Sharp Value Picks — +EV bets that beat the closing line"
  description="Value bets where the best bookmaker odds beat the market-fair price. +EV only. Backtested +8% ROI over 4,000+ picks."
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-slate-800/60">
    <div class="pointer-events-none absolute inset-0 grid-scan opacity-70"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-12 md:py-16 text-center">
      <div class="flex justify-center"><Mascot size={120} /></div>
      <p class="mt-4 hud text-gold">⚡ Sharp value // beats the closing line</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-black text-white leading-[1.0]">
        Where the price is <span class="text-gold text-glow">wrong</span>.
      </h1>
      <p class="mt-5 text-lg text-slate-300 max-w-2xl mx-auto">
        Not predictions — <span class="text-white">value</span>. Picks where the best bookmaker odds pay more than the market-fair probability. The only edge that actually beats the market.
      </p>
      <div class="mt-8 inline-grid grid-cols-3 gap-3 max-w-lg mx-auto">
        {[{ k: 'Backtested ROI', v: '+8.2%' }, { k: 'Sample', v: '4,115 picks' }, { k: 'Edge', v: '+EV only' }].map((s) => (
          <div class="card card-gold rounded-xl px-4 py-3">
            <p class="hud hud-dim">{s.k}</p>
            <p class="mt-1 font-mono text-lg md:text-xl font-bold text-white">{s.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIVE VALUE PICKS -->
  <section class="mx-auto max-w-6xl px-4 py-14 md:py-16">
    <div class="flex items-end justify-between gap-4 flex-wrap">
      <h2 class="font-display text-2xl md:text-3xl font-black text-white">Live value spots</h2>
      <p class="font-mono text-xs text-slate-500">Updated regularly · odds move, check before betting</p>
    </div>

    {picks.length > 0 ? (
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {picks.map((p) => <ValueCard pick={p} />)}
      </div>
    ) : (
      <div class="mt-8 card rounded-2xl p-10 text-center">
        <div class="flex justify-center mb-4"><Mascot size={72} /></div>
        <p class="font-display text-xl font-bold text-white">No value spots right now</p>
        <p class="mt-2 text-slate-400 max-w-md mx-auto">The market is efficient at the moment — no book is paying above fair. We scan continuously; genuine value is rare, and we'd rather show nothing than force a bad bet.</p>
      </div>
    )}
  </section>

  <!-- HOW IT WORKS -->
  <section class="mx-auto max-w-6xl px-4 py-14 md:py-16 border-t border-slate-800/60">
    <p class="hud text-gold">Method // no hunches</p>
    <h2 class="mt-2 font-display text-2xl md:text-3xl font-black text-white">How we find value</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {STEPS.map((s) => (
        <div class="card rounded-2xl p-6">
          <p class="font-mono text-gold text-sm">{s.n}</p>
          <p class="mt-2 font-display text-lg font-bold text-white">{s.t}</p>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">{s.d}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-xs text-slate-500 max-w-3xl leading-relaxed">
      Value betting is a long-game edge, not a guarantee — you win under half your bets and profit from the price. Variance is real; stake responsibly and never chase. {SITE.minAge}+ · odds shown are the best we saw at scan time and move constantly — always confirm at the book before betting. Gamble responsibly.
    </p>
  </section>
</Base>
