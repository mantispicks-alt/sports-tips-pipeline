---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { dedupeByMatch } from '../lib/dedupe';

const tips = dedupeByMatch(await getCollection('tips'));
const now = Date.now();
const upcoming = tips.filter((t) => t.data.result === 'pending' && +t.data.kickoff > now);

// Group by league. Sort by upcoming-tip count so hot leagues surface first.
const counts = new Map<string, { upcoming: number; total: number; won: number; lost: number }>();
for (const t of tips) {
  const key = t.data.league || 'Unknown';
  const row = counts.get(key) ?? { upcoming: 0, total: 0, won: 0, lost: 0 };
  row.total++;
  if (t.data.result === 'pending' && +t.data.kickoff > now) row.upcoming++;
  if (t.data.result === 'won') row.won++;
  if (t.data.result === 'lost') row.lost++;
  counts.set(key, row);
}
const leagues = [...counts.entries()]
  .filter(([name]) => name && name !== 'Unknown' && name !== 'Various')
  .sort((a, b) => (b[1].upcoming - a[1].upcoming) || (b[1].total - a[1].total));

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Leagues', href: '/leagues' },
];

// A curated subset of leagues (see src/lib/leagues.ts) has its own static
// hub at /leagues/<slug>. Everything else routes to the site search
// pre-filled with the league name.
import { LEAGUE_HUBS, tipMatchesLeague } from '../lib/leagues';
function leagueHref(name: string): string {
  const hub = LEAGUE_HUBS.find((h) => h.aliases.some((a) => a.toLowerCase() === name.trim().toLowerCase()));
  return hub ? `/leagues/${hub.slug}` : `/search?q=${encodeURIComponent(name)}`;
}
---

<Base
  title="Predictions by League"
  description="Football betting predictions organised by league — Premier League, La Liga, Serie A, Bundesliga, Champions League and 500+ competitions."
  breadcrumbs={crumbs}
>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Predictions by League</h1>
    <p class="mt-2 text-slate-400 max-w-2xl">
      Every league we've published a pick for, sorted by upcoming action. {leagues.length} competitions tracked.
    </p>

    <div class="mt-6">
      <input
        type="search"
        id="leagueFilter"
        placeholder="Filter leagues…"
        aria-label="Filter leagues"
        class="w-full max-w-md rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white placeholder:text-slate-600 focus:border-brand-500 outline-none transition"
      />
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" id="leagueGrid">
      {leagues.map(([name, r]) => {
        const rate = r.won + r.lost > 0 ? Math.round((r.won / (r.won + r.lost)) * 100) : null;
        return (
          <a
            href={leagueHref(name)}
            class="league-item card rounded-xl p-4 hover:border-brand-500 transition group"
            data-name={name.toLowerCase()}
          >
            <div class="font-semibold text-white group-hover:text-brand-400 transition">{name}</div>
            <div class="mt-1 text-xs text-slate-400 flex flex-wrap gap-x-3 gap-y-0.5">
              {r.upcoming > 0 && <span class="text-brand-400">{r.upcoming} upcoming</span>}
              <span>{r.total} total</span>
              {rate !== null && <span>{rate}% WR</span>}
            </div>
          </a>
        );
      })}
    </div>

    <p id="leagueEmpty" class="mt-8 text-sm text-slate-500 hidden">No leagues match your filter.</p>
  </section>

  <script>
    const input = document.getElementById('leagueFilter') as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLAnchorElement>('.league-item');
    const empty = document.getElementById('leagueEmpty');
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((el) => {
        const match = !q || (el.dataset.name || '').includes(q);
        el.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    });
  </script>
</Base>
