---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex={true}>
  <section class="mx-auto max-w-xl px-4 py-28 text-center">
    <p class="font-display text-6xl font-extrabold text-brand-400">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-white">We couldn't find that page</h1>
    <p class="mt-2 text-slate-400">It may have moved, or the match is over.</p>
    <a href="/" class="mt-6 inline-flex font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl">Back home →</a>
  </section>
</Base>
