---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import { SITE, TIERS, BILLING } from '../config';

// Phase 1: checkout/auth not wired yet, so paid CTAs capture the lead via the
// free channel. Phase 2 swaps these hrefs for POST /api/checkout?plan=<id>.
const ctaHref = (id: string) => (id === 'free' ? '/tips' : SITE.telegram);

const faqs = [
  {
    q: 'How are the picks delivered?',
    a: 'Free picks are on the site every day. Premium unlocks every daily pick plus the full model. VIP adds our highest-confidence "strike" picks, curated accumulators and a private Telegram channel where they land the moment the model flags value.',
  },
  {
    q: 'Do you guarantee winners?',
    a: 'No one honest does. We run a real expected-goals model and publish every result — wins and losses. Over a season the edge shows in the ROI, not in any single bet.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. Membership is month-to-month — cancel in one click and you keep access until the period ends. No lock-in, no fees to leave.',
  },
  {
    q: 'Which sports are covered?',
    a: 'Football and basketball, across the major European leagues and competitions. More markets are added as the model is validated on them.',
  },
];
---

<Base
  title="VIP Membership & Pricing"
  description="Unlock every the site prediction, the full expected-goals model and VIP high-confidence picks. Free, Premium and VIP plans — cancel anytime."
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-slate-800/60">
    <div class="pointer-events-none absolute inset-0 grid-scan opacity-70"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-10 md:pt-20 text-center">
      <div class="flex justify-center"><Mascot size={72} /></div>
      <p class="mt-4 hud">Membership // choose your edge</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-black text-white leading-[1.0]">
        Bet with the <span class="text-brand-400 text-glow">whole</span> arsenal.
      </h1>
      <p class="mt-5 text-lg text-slate-300 max-w-2xl mx-auto">
        Start free and see the record for yourself. Upgrade when you want every pick, the full model and the
        sharpest strikes we have. Cancel in one click, anytime.
      </p>
    </div>
  </section>

  <!-- TIER CARDS -->
  <section class="mx-auto max-w-6xl px-4 -mt-2 pb-8 md:pb-12">
    <div class="grid gap-6 lg:grid-cols-3 items-start">
      {
        TIERS.map((tier) => (
          <div
            class:list={[
              'relative rounded-3xl p-6 md:p-7 flex flex-col',
              tier.highlight ? 'card card-gold glow-gold lg:-mt-4 lg:mb-4' : 'card',
            ]}
          >
            {tier.highlight && <span class="absolute inset-0 reticle pointer-events-none" />}
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-display text-2xl font-black text-white">{tier.name}</h2>
              {tier.badge && (
                <span
                  class:list={[
                    'font-mono text-[10px] uppercase tracking-wider font-bold px-2.5 py-1 rounded-full border',
                    tier.highlight ? 'text-gold border-gold/50 bg-gold/10' : 'text-brand-400 border-brand-500/40 bg-brand-500/10',
                  ]}
                >
                  {tier.badge}
                </span>
              )}
            </div>
            <p class="mt-1 text-sm text-slate-400">{tier.tagline}</p>

            <div class="mt-5 flex items-end gap-1.5">
              <span class="font-display text-5xl font-black text-white">
                {tier.price === 0 ? '€0' : `${BILLING.currency}${tier.price}`}
              </span>
              <span class="mb-1.5 font-mono text-xs text-slate-500">/ {tier.period}</span>
            </div>

            <a
              href={ctaHref(tier.id)}
              class:list={[
                'mt-6 block text-center font-bold rounded-xl py-3 transition',
                tier.id === 'free'
                  ? 'text-white border border-slate-700 hover:border-brand-500'
                  : 'text-slate-950 bg-brand-500 hover:bg-brand-400 glow',
              ]}
            >
              {tier.cta} →
            </a>

            <ul class="mt-6 space-y-3">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm">
                  {f.included ? (
                    <span class="mt-0.5 shrink-0 grid place-items-center w-4 h-[18px] hex bg-brand-500/20 text-brand-400">
                      <svg viewBox="0 0 24 24" class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  ) : (
                    <span class="mt-0.5 shrink-0 grid place-items-center w-4 h-[18px] hex bg-slate-800 text-slate-600">
                      <svg viewBox="0 0 24 24" class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 12h12" stroke-linecap="round"/></svg>
                    </span>
                  )}
                  <span class:list={[f.included ? 'text-slate-200' : 'text-slate-500']}>{f.label}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {!BILLING.live && (
      <p class="mt-6 text-center font-mono text-[11px] tracking-wide text-slate-500">
        Secure card checkout is launching shortly · start free today · {SITE.minAge}+ · play responsibly
      </p>
    )}
  </section>

  <!-- TRUST STRIP -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="grid sm:grid-cols-3 gap-4">
      {
        [
          { k: 'Cancel anytime', v: 'Month-to-month. One click to stop.' },
          { k: 'Public record', v: 'Every settled pick — wins and losses.' },
          { k: 'Real model', v: 'Poisson expected-goals, not hunches.' },
        ].map((x) => (
          <div class="card rounded-2xl p-5">
            <p class="hud text-gold">{x.k}</p>
            <p class="mt-2 text-sm text-slate-300">{x.v}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <p class="hud text-center">FAQ</p>
    <h2 class="mt-2 text-center font-display text-3xl font-black text-white">Before you upgrade</h2>
    <div class="mt-8 space-y-3">
      {
        faqs.map((f) => (
          <details class="card rounded-2xl px-5 py-4 group">
            <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-white">
              {f.q}
              <span class="text-brand-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm text-slate-400 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <div class="relative rounded-3xl bg-gradient-to-br from-brand-600/20 via-slate-900 to-slate-900 border border-brand-500/30 p-8 md:p-12 text-center overflow-hidden">
      <span class="absolute inset-0 reticle pointer-events-none"></span>
      <h2 class="font-display text-3xl md:text-4xl font-black text-white">Try it free. Upgrade when you're convinced.</h2>
      <p class="mt-3 text-slate-300 max-w-xl mx-auto">One free pick a day, forever. No card needed to start.</p>
      <a href="/tips" class="mt-7 inline-flex font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl transition glow">
        See today's free pick →
      </a>
    </div>
  </section>
</Base>
