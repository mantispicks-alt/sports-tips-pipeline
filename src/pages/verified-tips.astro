---
import Base from '../layouts/Base.astro';
import { runPipeline } from '../lib/aggregation';

const data = await runPipeline();
const bt = data.backtest;
const rbt = data.realBacktest;
const picks = data.upcoming;
const fresh = data.fresh;

const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit',
  }).format(new Date(iso));

const confColor = (c: number) => (c >= 80 ? 'text-brand-400' : c >= 72 ? 'text-emerald-300' : 'text-amber-400');
const tierChip: Record<string, string> = {
  elite: 'bg-brand-500/15 text-brand-400 border-brand-500/40',
  strong: 'bg-sky-500/15 text-sky-300 border-sky-500/40',
  average: 'bg-slate-600/30 text-slate-300 border-slate-600/40',
  unproven: 'bg-slate-700/30 text-slate-400 border-slate-700/40',
};
---

<Base
  title="Verified Consensus Tips"
  description="Public tips from top tipsters, aggregated, weighted by proven reliability and filtered to only the highest-confidence, backtested selections."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <span class="inline-flex items-center gap-2 text-xs font-semibold text-brand-400 border border-brand-500/30 rounded-full px-3 py-1">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
      Aggregated from {data.tipsters.length} tracked tipsters
    </span>
    <h1 class="mt-4 font-display text-3xl md:text-4xl font-extrabold text-white">Verified Consensus Tips</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">
      We collect public tips from many tipsters, score each one on their <em>proven</em> track record, then
      surface only the selections where the best-performing tipsters agree. No noise — just the highest-confidence bets.
    </p>

    <div class="mt-5 flex items-start gap-2 text-sm rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-amber-200/90">
      <span>⚙️</span>
      <span>
        <strong>Demo mode.</strong> This feed is running on synthetic sample data to show the engine working.
        Connect real sources (data APIs, permitted feeds, opt-in tipster submissions) and all numbers become live.
      </span>
    </div>

    <!-- How it works -->
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        [
          { n: '1', t: 'Aggregate', d: `Pull public tips from every source into one place (${data.totalTipsIngested.toLocaleString()} tips across ${data.matchesCovered} matches).` },
          { n: '2', t: 'Weight by reliability', d: 'Score each tipster on real win rate & ROI. Lucky small samples are shrunk toward neutral.' },
          { n: '3', t: 'Filter to verified', d: 'Keep only picks where enough high-rated tipsters agree and confidence clears the bar.' },
        ].map((s) => (
          <div class="card rounded-2xl p-5">
            <span class="inline-grid place-items-center w-8 h-8 rounded-lg bg-brand-500 text-slate-950 font-bold">{s.n}</span>
            <h3 class="mt-3 font-display font-bold text-white">{s.t}</h3>
            <p class="mt-1 text-sm text-slate-400">{s.d}</p>
          </div>
        ))
      }
    </div>

    <!-- REAL track record — starts at zero, only grows from real settled matches -->
    <div class="mt-8 rounded-3xl bg-gradient-to-br from-emerald-600/15 to-slate-900 border border-emerald-500/30 p-6 md:p-8">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="font-display text-xl font-extrabold text-white">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1"></span>
          Real track record (live)
        </h2>
        <span class="text-xs text-slate-400">{rbt.picks} settled real picks, cross-checked by 2+ sources</span>
      </div>
      {rbt.picks === 0 ? (
        <p class="mt-5 text-sm text-slate-400">
          Tracking started — no real picks have settled yet. Check back after today's matches finish
          (run <code class="text-emerald-300">scripts/settle-real.mjs</code> to update).
        </p>
      ) : (
        <div class="mt-5 grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center"><p class="font-display text-3xl font-extrabold text-emerald-400">{rbt.winRate}%</p><p class="text-xs text-slate-400 mt-1">Win rate</p></div>
          <div class:list={['text-center']}><p class:list={['font-display text-3xl font-extrabold', rbt.roi >= 0 ? 'text-emerald-400' : 'text-rose-400']}>{rbt.roi >= 0 ? '+' : ''}{rbt.roi}%</p><p class="text-xs text-slate-400 mt-1">ROI</p></div>
          <div class="text-center"><p class:list={['font-display text-3xl font-extrabold', rbt.profit >= 0 ? 'text-emerald-400' : 'text-rose-400']}>{rbt.profit >= 0 ? '+' : ''}{rbt.profit}u</p><p class="text-xs text-slate-400 mt-1">Profit (1u)</p></div>
          <div class="text-center"><p class="font-display text-3xl font-extrabold text-white">{rbt.won}/{rbt.picks}</p><p class="text-xs text-slate-400 mt-1">Winners</p></div>
        </div>
      )}
      <p class="mt-4 text-[11px] text-slate-500">Real matches only, no synthetic data. Only picks 2+ independent sources agree on. Grows as matches finish.</p>
    </div>

    <!-- Backtest proof (demo/illustrative) -->
    <div class="mt-8 rounded-3xl bg-gradient-to-br from-brand-600/15 to-slate-900 border border-brand-500/30 p-6 md:p-8">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="font-display text-xl font-extrabold text-white">Illustrative demo: how the engine scores (synthetic data)</h2>
        <span class="text-xs text-slate-400">{bt.picks} settled verified picks</span>
      </div>
      <div class="mt-5 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="text-center"><p class="font-display text-3xl font-extrabold text-brand-400">{bt.winRate}%</p><p class="text-xs text-slate-400 mt-1">Win rate</p></div>
        <div class="text-center"><p class:list={['font-display text-3xl font-extrabold', bt.roi >= 0 ? 'text-brand-400' : 'text-rose-400']}>{bt.roi >= 0 ? '+' : ''}{bt.roi}%</p><p class="text-xs text-slate-400 mt-1">ROI</p></div>
        <div class="text-center"><p class:list={['font-display text-3xl font-extrabold', bt.profit >= 0 ? 'text-brand-400' : 'text-rose-400']}>{bt.profit >= 0 ? '+' : ''}{bt.profit}u</p><p class="text-xs text-slate-400 mt-1">Profit (1u)</p></div>
        <div class="text-center"><p class="font-display text-3xl font-extrabold text-white">{bt.won}/{bt.picks}</p><p class="text-xs text-slate-400 mt-1">Winners</p></div>
      </div>
      <p class="mt-4 text-[11px] text-slate-500">Illustrative backtest on tracked history. Past performance is not a guarantee of future results.</p>
    </div>

    <!-- Upcoming verified picks -->
    <h2 class="font-display text-2xl font-extrabold text-white mt-12 mb-1">Upcoming verified picks</h2>
    <p class="text-slate-400 mb-6">Only the selections that pass every filter. Ranked by confidence.</p>

    {picks.length === 0 ? (
      <p class="text-slate-400 card rounded-2xl p-6">No verified picks right now — check back closer to kickoff.</p>
    ) : (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {picks.map((p) => (
          <article class="card rounded-2xl p-5 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-400">{p.league}</span>
              <span class:list={['font-display font-extrabold text-lg', confColor(p.confidence)]}>{p.confidence}<span class="text-xs text-slate-500">/100</span></span>
            </div>
            <div>
              <p class="font-display font-bold text-white leading-snug">{p.homeTeam} vs {p.awayTeam}</p>
              <p class="text-xs text-slate-500 mt-0.5">{fmt(p.kickoff)}</p>
            </div>
            <div class="rounded-xl bg-slate-800/40 p-3 flex items-center justify-between">
              <div>
                <p class="text-[10px] uppercase text-slate-500">Consensus pick</p>
                <p class="text-brand-400 font-semibold">{p.label}</p>
              </div>
              {p.avgOdds > 0 && <span class="font-display text-xl font-extrabold text-white">{p.avgOdds.toFixed(2)}</span>}
            </div>
            <div class="flex items-center gap-4 text-xs text-slate-400">
              <span><strong class="text-slate-200">{p.backerCount}</strong> tipsters</span>
              <span><strong class="text-slate-200">{p.consensusPct}%</strong> agree</span>
              <span>avg rating <strong class="text-slate-200">{p.avgRating}</strong></span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {p.backers.slice(0, 4).map((b) => (
                <span class="text-[10px] text-slate-300 border border-slate-700 rounded px-1.5 py-0.5">
                  {b.tipster} <span class="text-slate-500">{b.rating}</span>
                </span>
              ))}
              {p.backerCount > 4 && <span class="text-[10px] text-slate-500 px-1 py-0.5">+{p.backerCount - 4}</span>}
            </div>
            <a href="/offers" class="mt-1 text-center text-sm font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-lg py-2.5 transition">
              Find best odds →
            </a>
          </article>
        ))}
      </div>
    )}

    <!-- Freshly ingested from real external sites -->
    <div class="mt-14">
      <h2 class="font-display text-2xl font-extrabold text-white">🔴 Live ingest — real tipster sites</h2>
      <p class="text-slate-400 mt-1 mb-4 max-w-3xl">
        Pulled today from real prediction sites via the pipeline. <span class="text-amber-300 font-semibold">Unverified</span> —
        these tipsters have no track record with us yet, so they are <strong>not</strong> in the verified picks above. They earn a
        rating and can qualify only after their results settle. This is your model working: ingest everything, prove, then promote.
      </p>

      {fresh.length === 0 ? (
        <p class="text-slate-500 card rounded-2xl p-6">Nothing freshly ingested right now.</p>
      ) : (
        <div class="overflow-x-auto card rounded-2xl">
          <table class="w-full text-sm min-w-[720px]">
            <thead>
              <tr class="text-left text-[11px] uppercase tracking-wide text-slate-500 border-b border-slate-800">
                <th class="py-3 pl-5 pr-4">Match</th>
                <th class="pr-4">League</th>
                <th class="pr-4">Consensus pick</th>
                <th class="pr-4">Sources</th>
                <th class="pr-5">Who</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {fresh.map((p) => (
                <tr class="hover:bg-slate-800/20">
                  <td class="py-3 pl-5 pr-4 text-white whitespace-nowrap">
                    {p.homeTeam} vs {p.awayTeam}
                    {!p.dateVerified && (
                      <span class="text-[10px] text-amber-400 border border-amber-500/40 rounded px-1.5 py-0.5 ml-1" title="Kickoff time not confirmed against a real fixture yet — could be stale.">date unconfirmed</span>
                    )}
                  </td>
                  <td class="pr-4 text-slate-400 whitespace-nowrap">{p.league}</td>
                  <td class="pr-4 text-brand-400 whitespace-nowrap">{p.label}</td>
                  <td class="pr-4">
                    <span class:list={['font-bold', p.backerCount > 1 ? 'text-brand-400' : 'text-slate-300']}>{p.backerCount}×</span>
                    {p.backerCount > 1 && <span class="text-[10px] text-brand-400 border border-brand-500/40 rounded px-1.5 py-0.5 ml-1">consensus</span>}
                  </td>
                  <td class="pr-5 text-xs text-slate-400">{[...new Set(p.backers.map((b) => b.tipster))].join(', ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Sources + note -->
    <div class="mt-12 card rounded-2xl p-6 text-sm text-slate-400 leading-relaxed">
      <p class="font-semibold text-white mb-2">Sources & method</p>
      <p>
        Tips are ingested through pluggable source adapters — official data APIs, permitted feeds and opt-in
        tipster submissions. See the <a href="/tipsters" class="text-brand-400">tipster leaderboard</a> for the full
        ranking and <a href="/methodology" class="text-brand-400">methodology</a> for how confidence is scored.
      </p>
      <p class="mt-2 text-xs text-slate-500">
        Current data source: {data.sources.join(', ')}. 18+ · Odds change — always confirm before betting · Gamble responsibly.
      </p>
    </div>
  </section>
</Base>
