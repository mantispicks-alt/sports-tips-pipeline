---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Betting News & Analysis" description="Betting strategy guides, match previews and sports analysis from the the site team.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">News & Analysis</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">Strategy guides, previews and the thinking behind our tips.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {articles.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>
</Base>
