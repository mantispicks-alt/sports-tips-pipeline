---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TipCard from '../../components/TipCard.astro';
import { dedupeByMatch } from '../../lib/dedupe';
import { LEAGUE_HUBS, tipMatchesLeague, type LeagueHub } from '../../lib/leagues';

export async function getStaticPaths() {
  return LEAGUE_HUBS.map((hub) => ({ params: { slug: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props as { hub: LeagueHub };
const all = dedupeByMatch(await getCollection('tips')).filter((t) => tipMatchesLeague(t.data.league, hub));
const now = Date.now();
const upcoming = all
  .filter((t) => t.data.result === 'pending' && +t.data.kickoff > now)
  .sort((a, b) => +a.data.kickoff - +b.data.kickoff);
const settled = all.filter((t) => t.data.result === 'won' || t.data.result === 'lost');
const won = settled.filter((t) => t.data.result === 'won').length;
const winRate = settled.length ? Math.round((won / settled.length) * 100) : null;
const recentSettled = settled.sort((a, b) => +b.data.kickoff - +a.data.kickoff).slice(0, 6);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Leagues', href: '/leagues' },
  { name: hub.displayEn, href: `/leagues/${hub.slug}` },
];

// SportsOrganization schema for the league.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: hub.displayEn,
  sport: 'Football',
  location: { '@type': 'Place', name: hub.country },
  url: new URL(`/leagues/${hub.slug}`, Astro.site ?? 'https://example.pages.dev').href,
};
---

<Base
  title={`${hub.displayEn} Betting Tips & Predictions`}
  description={`Free ${hub.displayEn} betting tips and predictions. ${hub.descEn} Tracked publicly with a full pick record.`}
  breadcrumbs={crumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <p class="hud text-brand-400">{hub.country}</p>
        <h1 class="mt-1 font-display text-3xl md:text-4xl font-extrabold text-white">{hub.displayEn} Tips</h1>
        <p class="mt-2 text-slate-400 max-w-2xl">{hub.descEn}</p>
      </div>
      {winRate !== null && (
        <div class="card rounded-xl px-4 py-3 text-right">
          <p class="hud hud-dim">Strike rate</p>
          <p class="mt-1 font-mono text-xl font-bold text-white">{winRate}%</p>
          <p class="mt-0.5 text-[10px] text-slate-500">{won}/{settled.length} settled</p>
        </div>
      )}
    </div>

    <h2 class="mt-10 font-display text-2xl font-black text-white">Upcoming picks</h2>
    {upcoming.length > 0 ? (
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {upcoming.map((entry) => (<TipCard entry={entry} />))}
      </div>
    ) : (
      <div class="mt-4 card rounded-xl p-6 text-slate-400 text-sm">
        No upcoming {hub.displayEn} picks published right now — check back after the next update cycle, or see all sports on <a href="/tips" class="text-brand-400 underline">/tips</a>.
      </div>
    )}

    {recentSettled.length > 0 && (
      <>
        <h2 class="mt-14 font-display text-2xl font-black text-white">Recent settled results</h2>
        <p class="text-slate-400 mt-1 text-sm">The last {recentSettled.length} settled {hub.displayEn} picks — wins and losses.</p>
        <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {recentSettled.map((entry) => (<TipCard entry={entry} />))}
        </div>
      </>
    )}

    <div class="mt-14 card rounded-2xl p-6 leading-relaxed text-sm text-slate-300">
      <h2 class="font-display text-white text-lg font-bold mb-2">How our {hub.displayEn} picks are made</h2>
      <p>
        Every {hub.displayEn} tip on the site is generated by our proprietary consensus engine, which cross-checks multiple independent market and model signals against our own audited settled record before publishing. A pick only publishes when strict, deterministic audit rules are satisfied. Full methodology on <a href="/methodology" class="text-brand-400 underline">/methodology</a>.
      </p>
      <p class="mt-3">
        Every {hub.displayEn} pick is tracked publicly and settled from real match scores — no cherry-picking, no silent edits.
      </p>
    </div>
  </section>
</Base>
