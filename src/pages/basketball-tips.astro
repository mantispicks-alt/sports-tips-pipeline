---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TipCard from '../components/TipCard.astro';
import { dedupeByMatch } from '../lib/dedupe';

const all = dedupeByMatch(await getCollection('tips')).filter((t) => t.data.sport === 'basketball');
const now = Date.now();
const upcoming = all
  .filter((t) => t.data.result === 'pending' && +t.data.kickoff > now)
  .sort((a, b) => +a.data.kickoff - +b.data.kickoff);
const settled = all.filter((t) => t.data.result === 'won' || t.data.result === 'lost');
const won = settled.filter((t) => t.data.result === 'won').length;
const winRate = settled.length ? Math.round((won / settled.length) * 100) : null;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Predictions', href: '/tips' },
  { name: 'Basketball tips', href: '/basketball-tips' },
];
---

<Base
  title="Basketball Betting Tips & Predictions"
  description="Free daily basketball betting tips and predictions. NBA, EuroLeague, ACB and more — with real analysis, model probabilities and best odds."
  breadcrumbs={crumbs}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Basketball Tips</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">
      Free upcoming basketball predictions from our 70-source consensus pipeline — NBA, EuroLeague, ACB, Turkish Super League and more.
      {winRate !== null && (
        <span> Basketball-only strike rate so far: <span class="text-brand-400 font-semibold">{winRate}%</span> ({won}/{settled.length}).</span>
      )}
      Full record on <a href="/results" class="text-brand-400 underline hover:text-brand-300">/results</a>.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {upcoming.map((entry) => (<TipCard entry={entry} />))}
    </div>
    {upcoming.length === 0 && (
      <div class="mt-8 card rounded-xl p-6 text-slate-400 text-sm">
        No upcoming basketball picks published right now — check back after the next 2-hour cycle, or see all sports on <a href="/tips" class="text-brand-400 underline">/tips</a>.
      </div>
    )}

    <div class="mt-14 card rounded-2xl p-6 leading-relaxed text-sm text-slate-300">
      <h2 class="font-display text-white text-lg font-bold mb-2">How our basketball picks are made</h2>
      <p>
        Every basketball tip on the site is generated by cross-checking predictions from 70+ tipster sites, sharp price feeds and prediction models with pace-adjusted points-for/against expectancy.
        A pick publishes only when independent sources agree AND at least one has an audited +ROI edge in that odds band.
        The full pipeline is on our <a href="/methodology" class="text-brand-400 underline">Methodology page</a>.
      </p>
      <p class="mt-3">
        Every basketball pick is tracked publicly and settled from real match scores — no cherry-picking, no silent edits.
      </p>
    </div>
  </section>
</Base>
