---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TipCard from '../components/TipCard.astro';
import OfferCard from '../components/OfferCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EquityChart from '../components/EquityChart.astro';
import Newsletter from '../components/Newsletter.astro';
import { computeResults } from '../lib/results';
import { SITE, TIERS, BILLING } from '../config';

const allTips = await getCollection('tips');
const now = Date.now();
const tips = [...allTips].sort((a, b) => +b.data.kickoff - +a.data.kickoff);
// Only picks whose kickoff is still ahead. A finished match shown as an open
// pick is the #1 "looks broken/scam" signal — settled ones live on /results.
const upcoming = tips
  .filter((t) => t.data.result === 'pending' && +t.data.kickoff > now)
  .sort((a, b) => +a.data.kickoff - +b.data.kickoff); // soonest first
const featuredTips = upcoming.filter((t) => t.data.featured);
const topTips = (featuredTips.length ? featuredTips : upcoming).slice(0, 3);
const strike = topTips[0] ?? null;

const bookmakers = (await getCollection('bookmakers'))
  .filter((b) => b.data.type === 'sportsbook')
  .sort((a, b) => a.data.order - b.data.order);
const topOffers = bookmakers.slice(0, 3);

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const r = computeResults(allTips);
const hasRecord = r.settled > 0;

const sportIcon: Record<string, string> = { football: '⚽', basketball: '🏀', tennis: '🎾' };

const fmtKick = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', {
    weekday: 'short',
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  }).format(d);

// Hero readout — real stats once there's a record; honest system status until then.
const STATS = hasRecord
  ? [
      { k: 'Win rate', v: `${r.winRate}%` },
      { k: 'ROI', v: `${r.roi >= 0 ? '+' : ''}${r.roi}%` },
      { k: 'Settled', v: `${r.settled}` },
      { k: 'Avg odds', v: r.avgOdds.toFixed(2) },
    ]
  : [
      { k: 'Model', v: 'Poisson' },
      { k: 'Sports', v: '⚽ · 🏀' },
      { k: 'Results', v: 'Public' },
      { k: 'Price', v: 'Free' },
    ];
---

<Base>
  <!-- ================= HERO — "the ambush" ============================= -->
  <section class="relative overflow-hidden border-b border-slate-800/60">
    <div class="pointer-events-none absolute inset-0 grid-scan opacity-80"></div>
    <div
      aria-hidden="true"
      class="pointer-events-none select-none absolute right-[-70px] top-1/2 -translate-y-1/2 w-[560px] h-[440px] overflow-hidden opacity-25 mix-blend-screen hidden lg:block"
      style="mask-image:radial-gradient(58% 58% at 52% 44%,#000 0%,transparent 74%);-webkit-mask-image:radial-gradient(58% 58% at 52% 44%,#000 0%,transparent 74%);filter:drop-shadow(0 0 46px rgba(123,207,42,0.28))"
    >
      <img src="/logo.jpeg" alt="" class="w-full object-cover object-top" />
    </div>

    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-14 md:pt-24 md:pb-20 grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      <!-- copy -->
      <div class="lg:col-span-7">
        <span class="hud inline-flex items-center gap-2 rise" style="animation-delay:.04s">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 live-dot"></span>
          Live // data-driven predictions
        </span>

        <h1 class="mt-5 font-display text-5xl md:text-7xl font-black text-white leading-[0.95] rise" style="animation-delay:.12s">
          The market blinks.<br />
          <span class="text-brand-400 text-glow">We strike.</span>
        </h1>

        <p class="mt-6 text-lg text-slate-300 max-w-xl rise" style="animation-delay:.2s">
          Free football &amp; basketball predictions from a real expected-goals model. Every pick is tracked in
          public — wins and losses, no cherry-picking.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3 rise" style="animation-delay:.28s">
          <a href="/tips" class="font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl transition glow">
            See today's predictions →
          </a>
          <a href="/results" class="font-semibold text-gold border border-gold/40 hover:bg-gold/10 px-6 py-3 rounded-xl transition">
            Track record
          </a>
        </div>

        <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3 rise" style="animation-delay:.36s">
          {
            STATS.map((s) => (
              <div class="card rounded-xl px-4 py-3">
                <p class="hud hud-dim">{s.k}</p>
                <p class="mt-1 font-mono text-xl md:text-2xl font-bold text-white">{s.v}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- today's strike / next drop -->
      <div class="lg:col-span-5 rise" style="animation-delay:.22s">
        <div class="relative card card-gold rounded-3xl p-5 sm:p-6 reticle overflow-hidden">
          <span class="absolute inset-0 reticle-x pointer-events-none"></span>
          <span class="scanline"></span>

          {
            strike ? (
              <div class="relative">
                <div class="flex items-center justify-between">
                  <span class="hud text-gold">Today's strike</span>
                  <span class="hud hud-dim inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-400 live-dot" />
                    locked
                  </span>
                </div>

                <p class="mt-4 flex items-center gap-1.5 text-xs text-slate-400">
                  <span>{sportIcon[strike.data.sport] ?? '🏆'}</span>
                  <span class="truncate">{strike.data.league}</span>
                  <span class="text-slate-600">·</span>
                  <span class="font-mono text-[11px] text-slate-500">{fmtKick(strike.data.kickoff)}</span>
                </p>

                <a href={`/tips/${strike.id}`} class="mt-1 block font-display text-2xl font-extrabold text-white leading-tight hover:text-brand-400 transition">
                  {strike.data.match}
                </a>

                <div class="mt-5 flex items-end justify-between gap-4">
                  <div class="min-w-0">
                    <p class="hud hud-dim">Pick</p>
                    <p class="font-display text-xl font-bold text-brand-400 leading-tight truncate">{strike.data.pick}</p>
                    <p class="mt-0.5 text-[11px] text-slate-500">{strike.data.market}</p>
                    <div class="mt-2 flex items-center gap-1" aria-label={`Confidence ${strike.data.confidence} of 5`}>
                      {Array.from({ length: 5 }).map((_, i) => (
                        <span class:list={['pip', i < strike.data.confidence && 'on-gold']} />
                      ))}
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <p class="hud hud-dim">Odds</p>
                    <p class="font-mono text-4xl font-bold text-white leading-none">{strike.data.odds.toFixed(2)}</p>
                  </div>
                </div>

                <a
                  href={strike.data.bookmakerSlug ? `/bookmakers/${strike.data.bookmakerSlug}` : `/tips/${strike.id}`}
                  class="mt-5 block text-center text-sm font-bold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-xl py-3 transition"
                >
                  {strike.data.bookmakerSlug ? `Back it at ${strike.data.bookmaker ?? 'top book'} →` : 'Read the analysis →'}
                </a>
              </div>
            ) : (
              <div class="relative text-center py-2">
                <div class="flex items-center justify-between">
                  <span class="hud text-gold">Next drop</span>
                  <span class="hud hud-dim inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-400 live-dot" />
                    model live
                  </span>
                </div>
                <div class="mt-6 grid place-items-center">
                  <span class="grid place-items-center w-16 h-16 hex bg-brand-500/10 ring-1 ring-brand-500/30">
                    <span class="text-3xl">🦗</span>
                  </span>
                </div>
                <p class="mt-4 font-display text-2xl font-extrabold text-white">Picks drop daily</p>
                <p class="mt-2 text-sm text-slate-400 max-w-xs mx-auto">
                  The model is scanning today's fixtures for value. Be first in line when the next strike lands.
                </p>
                <a href={SITE.telegram} class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-xl px-5 py-3 transition">
                  Get it on Telegram →
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BONUSES TICKER ================================= -->
  <div class="relative border-b border-slate-800/60 bg-black/40 overflow-hidden py-2.5">
    <div class="flex gap-8 whitespace-nowrap animate-marquee w-max">
      {
        [...bookmakers, ...bookmakers].map((b) => (
          <span class="inline-flex items-center gap-2 text-sm text-slate-400">
            <span class="pip hex-flat" style="width:.5rem;height:.56rem" />
            <span class="font-semibold text-white">{b.data.name}</span>
            <span class="font-mono text-brand-400">{b.data.bonus}</span>
          </span>
        ))
      }
    </div>
    <div class="absolute inset-y-0 left-0 z-10 flex items-center pl-4 pr-10 bg-gradient-to-r from-[#070b07] via-[#070b07] to-transparent">
      <span class="hud text-gold">Bonuses //</span>
    </div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-[#070b07] to-transparent"></div>
  </div>

  <!-- ================= TOP PREDICTIONS ================================ -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="hud">Predictions</p>
        <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Today's sharpest bets</h2>
        <p class="text-slate-400 mt-2">Our highest-confidence value spots — always free.</p>
      </div>
      <a href="/tips" class="shrink-0 text-sm font-semibold text-brand-400 hover:text-brand-300">All picks →</a>
    </div>

    {
      topTips.length ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {topTips.map((entry) => <TipCard entry={entry} />)}
        </div>
      ) : (
        <div class="card rounded-3xl p-10 text-center relative overflow-hidden">
          <div class="pointer-events-none absolute inset-0 grid-scan opacity-60"></div>
          <p class="relative hud text-brand-400">No open picks</p>
          <p class="relative mt-3 font-display text-2xl font-extrabold text-white">The model is hunting</p>
          <p class="relative mt-2 text-slate-400 max-w-md mx-auto">
            There are no open value spots right now. New predictions drop daily — get them the second they land.
          </p>
          <a href={SITE.telegram} class="relative mt-6 inline-flex font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl transition">
            Get picks on Telegram →
          </a>
        </div>
      )
    }
  </section>

  <!-- ================= THE MODEL ====================================== -->
  <section class="mx-auto max-w-6xl px-4">
    <div class="relative rounded-3xl border border-slate-800 bg-slate-900/40 overflow-hidden p-8 md:p-10 grid md:grid-cols-3 gap-8 items-center">
      <div class="pointer-events-none absolute inset-0 grid-scan opacity-50"></div>
      <div class="relative md:col-span-2">
        <p class="hud text-gold">The method</p>
        <h2 class="mt-2 font-display text-3xl font-black text-white">Maths, not hunches.</h2>
        <p class="mt-3 text-slate-400 max-w-xl">
          Every football tip runs through a Poisson expected-goals model. You see the real probabilities for 1X2,
          Over/Under, BTTS and correct score — and we only tip a selection when the model finds genuine value against
          the market price.
        </p>
      </div>
      <a href="/methodology" class="relative justify-self-start md:justify-self-end font-semibold text-brand-400 border border-brand-500/40 hover:bg-brand-500/10 rounded-xl px-5 py-3 transition">
        How we predict →
      </a>
    </div>
  </section>

  <!-- ================= TRACK RECORD =================================== -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="relative card rounded-3xl p-8 overflow-hidden">
      <span class="absolute inset-0 reticle pointer-events-none"></span>
      <div class="flex items-end justify-between gap-4 mb-6">
        <div>
          <p class="hud">Track record</p>
          <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Transparent by default</h2>
          <p class="text-slate-400 mt-2">Every settled pick is public — wins and losses. We never delete our losers.</p>
        </div>
        <a href="/results" class="shrink-0 text-sm font-semibold text-brand-400 hover:text-brand-300">Full record →</a>
      </div>

      {
        hasRecord ? (
          <div class="grid md:grid-cols-3 gap-6 items-center">
            <div class="grid grid-cols-3 gap-3 md:col-span-1">
              <div class="text-center">
                <p class="font-mono text-2xl font-bold text-white">{r.winRate}%</p>
                <p class="hud hud-dim mt-1">Win rate</p>
              </div>
              <div class="text-center">
                <p class:list={['font-mono text-2xl font-bold', r.roi >= 0 ? 'text-brand-400' : 'text-rose-400']}>
                  {r.roi >= 0 ? '+' : ''}{r.roi}%
                </p>
                <p class="hud hud-dim mt-1">ROI</p>
              </div>
              <div class="text-center">
                <p class:list={['font-mono text-2xl font-bold', r.profit >= 0 ? 'text-brand-400' : 'text-rose-400']}>
                  {r.profit >= 0 ? '+' : ''}{r.profit}u
                </p>
                <p class="hud hud-dim mt-1">Profit</p>
              </div>
            </div>
            <div class="md:col-span-2">
              <EquityChart points={r.equity} height={120} />
            </div>
          </div>
        ) : (
          <div class="grid md:grid-cols-3 gap-6 items-center">
            <div class="md:col-span-1">
              <p class="font-mono text-5xl font-bold text-white">0.0<span class="text-2xl text-slate-500">u</span></p>
              <p class="mt-2 text-sm text-slate-400 max-w-xs">
                The record starts at zero and builds in the open. Watch it grow with every settled pick.
              </p>
            </div>
            <div class="md:col-span-2">
              <div class="relative h-[120px] rounded-2xl border border-dashed border-slate-700/70 grid-scan grid place-items-center">
                <span class="hud hud-dim">Awaiting first settled pick</span>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- ================= MEMBERSHIP ===================================== -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20 border-t border-slate-800/60">
    <div class="text-center">
      <p class="hud text-gold">Membership</p>
      <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Free to start. Sharp to upgrade.</h2>
      <p class="text-slate-400 mt-2 max-w-xl mx-auto">One free pick a day, forever. Unlock every pick, the full model and VIP strikes whenever you're ready.</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {
        TIERS.map((tier) => (
          <a
            href="/pricing"
            class:list={[
              'group relative rounded-2xl p-6 flex flex-col transition hover:-translate-y-1',
              tier.highlight ? 'card card-gold glow-gold' : 'card',
            ]}
          >
            <div class="flex items-center justify-between">
              <h3 class="font-display text-xl font-black text-white">{tier.name}</h3>
              {tier.badge && (
                <span class:list={['font-mono text-[9px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full border', tier.highlight ? 'text-gold border-gold/50' : 'text-brand-400 border-brand-500/40']}>{tier.badge}</span>
              )}
            </div>
            <p class="mt-3 flex items-end gap-1">
              <span class="font-display text-3xl font-black text-white">{tier.price === 0 ? '€0' : `${BILLING.currency}${tier.price}`}</span>
              <span class="mb-1 font-mono text-[11px] text-slate-500">/ {tier.period}</span>
            </p>
            <p class="mt-3 text-sm text-slate-400 flex-1">{tier.tagline}</p>
            <span class:list={['mt-4 text-sm font-semibold', tier.highlight ? 'text-gold' : 'text-brand-400']}>{tier.cta} →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ================= BONUSES ======================================== -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20 border-t border-slate-800/60">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="hud text-gold">Bonuses</p>
        <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Best welcome offers</h2>
        <p class="text-slate-400 mt-2">Hand-picked from licensed operators only.</p>
      </div>
      <a href="/offers" class="shrink-0 text-sm font-semibold text-brand-400 hover:text-brand-300">All offers →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {topOffers.map((entry, i) => <OfferCard entry={entry} rank={i + 1} />)}
    </div>
  </section>

  <!-- ================= WHY THE-SITE ================================ -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20 border-t border-slate-800/60">
    <div class="text-center">
      <p class="hud">Why the site</p>
      <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Patience. Precision. Proof.</h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        [
          {
            t: 'A real model',
            d: 'Poisson expected-goals maths behind every football tip — with the probabilities shown, not hidden.',
            gold: false,
            icon: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/>',
          },
          {
            t: 'Tracked results',
            d: 'Public win rate, ROI and profit curve. Wins and losses both — nothing quietly deleted.',
            gold: true,
            icon: '<path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
          },
          {
            t: 'Licensed only',
            d: 'We only feature bonuses from properly licensed, trustworthy operators. No shady books.',
            gold: false,
            icon: '<path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
          },
        ].map((f) => (
          <div class="card rounded-2xl p-6">
            <span
              class:list={[
                'grid place-items-center w-12 h-14 hex',
                f.gold ? 'bg-gold/12 text-gold' : 'bg-brand-500/12 text-brand-400',
              ]}
            >
              <svg viewBox="0 0 24 24" class="w-6 h-6" set:html={f.icon} />
            </span>
            <h3 class="mt-4 font-display font-bold text-white text-lg">{f.t}</h3>
            <p class="mt-2 text-sm text-slate-400">{f.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= ANALYSIS ======================================= -->
  {
    articles.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 md:py-20 border-t border-slate-800/60">
        <div class="flex items-end justify-between gap-4 mb-8">
          <div>
            <p class="hud">Analysis</p>
            <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Latest from the desk</h2>
          </div>
          <a href="/news" class="shrink-0 text-sm font-semibold text-brand-400 hover:text-brand-300">All analysis →</a>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {articles.map((entry) => (
            <ArticleCard entry={entry} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ================= NEWSLETTER ===================================== -->
  <section class="mx-auto max-w-4xl px-4 pb-8">
    <Newsletter />
  </section>

  <!-- ================= TELEGRAM ======================================= -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <div class="relative rounded-3xl bg-gradient-to-br from-brand-600/20 via-slate-900 to-slate-900 border border-brand-500/30 p-8 md:p-12 text-center overflow-hidden">
      <span class="absolute inset-0 reticle pointer-events-none"></span>
      <p class="hud">Free channel</p>
      <h2 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">Get every strike first on Telegram</h2>
      <p class="mt-3 text-slate-300 max-w-xl mx-auto">
        Our best bets land in the channel live during the day, the moment the model flags value — completely free.
      </p>
      <a href={SITE.telegram} class="mt-7 inline-flex items-center gap-2 font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl transition glow">
        Join the free channel →
      </a>
      <p class="mt-4 font-mono text-[10px] tracking-wide text-slate-500">
        Past results do not guarantee future returns · {SITE.minAge}+ · Play responsibly
      </p>
    </div>
  </section>
</Base>
