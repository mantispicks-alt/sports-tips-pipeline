---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TipCard from '../components/TipCard.astro';
import OfferCard from '../components/OfferCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EquityChart from '../components/EquityChart.astro';
import Newsletter from '../components/Newsletter.astro';
import { computeResults } from '../lib/results';
import { SITE } from '../config';

const allTips = await getCollection('tips');
const tips = [...allTips].sort((a, b) => +b.data.kickoff - +a.data.kickoff);
const featuredTips = tips.filter((t) => t.data.featured && t.data.result === 'pending');
const topTips = (featuredTips.length ? featuredTips : tips.filter((t) => t.data.result === 'pending')).slice(0, 3);

const bookmakers = (await getCollection('bookmakers')).sort((a, b) => a.data.order - b.data.order);
const topOffers = bookmakers.slice(0, 3);

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const r = computeResults(allTips);

const STATS = [
  { value: `${r.winRate}%`, label: 'Win rate' },
  { value: `${r.roi >= 0 ? '+' : ''}${r.roi}%`, label: 'ROI (tracked)' },
  { value: `${r.settled}`, label: 'Tips settled' },
  { value: '12,400', label: 'Members' },
];
---

<Base>
  <!-- HERO ---------------------------------------------------------------->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-12 md:pt-24 md:pb-16">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-brand-400 border border-brand-500/30 rounded-full px-3 py-1">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
          Data-driven predictions · tracked results
        </span>
        <h1 class="mt-5 font-display text-4xl md:text-6xl font-extrabold text-white leading-[1.05]">
          Bet smarter.<br />
          <span class="text-brand-400">Win more often.</span>
        </h1>
        <p class="mt-5 text-lg text-slate-300 max-w-xl">
          Free football & basketball tips powered by a real expected-goals model, honest bookmaker reviews and
          the biggest welcome bonuses in Europe — all tracked, all in one place.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/tips" class="font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl transition glow">
            Today's predictions →
          </a>
          <a href="/offers" class="font-semibold text-white border border-slate-700 hover:border-brand-500 px-6 py-3 rounded-xl transition">
            Claim free bets
          </a>
        </div>
      </div>

      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          STATS.map((s) => (
            <div class="card rounded-xl p-4 text-center">
              <p class="font-display text-2xl md:text-3xl font-extrabold text-white">{s.value}</p>
              <p class="text-xs text-slate-400 mt-1">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- OFFERS TICKER ------------------------------------------------------->
  <div class="border-y border-slate-800/60 bg-slate-950/40 overflow-hidden py-3">
    <div class="flex gap-8 whitespace-nowrap animate-marquee w-max">
      {
        [...bookmakers, ...bookmakers].map((b) => (
          <span class="text-sm text-slate-400">
            <span class="font-semibold text-white">{b.data.name}</span>
            <span class="text-brand-400"> · {b.data.bonus}</span>
          </span>
        ))
      }
    </div>
  </div>

  <!-- TOP PREDICTIONS ----------------------------------------------------->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="font-display text-2xl md:text-3xl font-extrabold text-white">Today's top predictions</h2>
        <p class="text-slate-400 mt-1">Our highest-confidence bets, free.</p>
      </div>
      <a href="/tips" class="text-sm text-brand-400 font-medium hover:text-brand-300 shrink-0">All tips →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {topTips.map((entry) => <TipCard entry={entry} />)}
    </div>
  </section>

  <!-- MODEL STRIP --------------------------------------------------------->
  <section class="mx-auto max-w-6xl px-4 pb-4">
    <div class="rounded-3xl border border-slate-800 bg-slate-900/40 p-8 grid md:grid-cols-3 gap-6 items-center">
      <div class="md:col-span-2">
        <h2 class="font-display text-2xl font-extrabold text-white">Predictions with maths, not hunches</h2>
        <p class="mt-2 text-slate-400 max-w-xl">
          Every football tip runs through a Poisson expected-goals model. We show you the probabilities for 1X2,
          Over/Under, BTTS and correct score — then only tip it when there's real value versus the odds.
        </p>
      </div>
      <a href="/methodology" class="justify-self-start md:justify-self-end font-semibold text-brand-400 border border-brand-500/40 hover:bg-brand-500/10 rounded-xl px-5 py-3 transition">
        How we predict →
      </a>
    </div>
  </section>

  <!-- RESULTS SNAPSHOT ---------------------------------------------------->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="card rounded-3xl p-8">
      <div class="flex items-end justify-between mb-6">
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-extrabold text-white">Transparent results</h2>
          <p class="text-slate-400 mt-1">Every tip tracked — wins and losses. No cherry-picking.</p>
        </div>
        <a href="/results" class="text-sm text-brand-400 font-medium hover:text-brand-300 shrink-0">Full record →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6 items-center">
        <div class="grid grid-cols-3 gap-3 md:col-span-1">
          <div class="text-center"><p class="font-display text-2xl font-extrabold text-white">{r.winRate}%</p><p class="text-[11px] text-slate-400">Win rate</p></div>
          <div class="text-center"><p class:list={['font-display text-2xl font-extrabold', r.roi >= 0 ? 'text-brand-400' : 'text-rose-400']}>{r.roi >= 0 ? '+' : ''}{r.roi}%</p><p class="text-[11px] text-slate-400">ROI</p></div>
          <div class="text-center"><p class:list={['font-display text-2xl font-extrabold', r.profit >= 0 ? 'text-brand-400' : 'text-rose-400']}>{r.profit >= 0 ? '+' : ''}{r.profit}u</p><p class="text-[11px] text-slate-400">Profit</p></div>
        </div>
        <div class="md:col-span-2">
          <EquityChart points={r.equity} height={110} />
        </div>
      </div>
    </div>
  </section>

  <!-- TOP OFFERS ---------------------------------------------------------->
  <section class="mx-auto max-w-6xl px-4 py-16 border-t border-slate-800/60">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="font-display text-2xl md:text-3xl font-extrabold text-white">Best bookmaker bonuses</h2>
        <p class="text-slate-400 mt-1">Hand-picked welcome offers from licensed operators.</p>
      </div>
      <a href="/offers" class="text-sm text-brand-400 font-medium hover:text-brand-300 shrink-0">All offers →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {topOffers.map((entry, i) => <OfferCard entry={entry} rank={i + 1} />)}
    </div>
  </section>

  <!-- WHY US -------------------------------------------------------------->
  <section class="mx-auto max-w-6xl px-4 py-16 border-t border-slate-800/60">
    <h2 class="font-display text-2xl md:text-3xl font-extrabold text-white text-center">Why {SITE.name}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        [
          { icon: '📊', t: 'A real model', d: 'Poisson expected-goals maths behind every football tip — see the probabilities yourself.' },
          { icon: '✅', t: 'Tracked results', d: 'Public win rate, ROI and profit curve. We never delete our losers.' },
          { icon: '🎁', t: 'Licensed offers only', d: 'We only feature bonuses from properly licensed, trustworthy operators.' },
        ].map((f) => (
          <div class="card rounded-2xl p-6">
            <div class="text-3xl">{f.icon}</div>
            <h3 class="mt-3 font-display font-bold text-white text-lg">{f.t}</h3>
            <p class="mt-2 text-sm text-slate-400">{f.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- LATEST NEWS --------------------------------------------------------->
  <section class="mx-auto max-w-6xl px-4 py-16 border-t border-slate-800/60">
    <div class="flex items-end justify-between mb-8">
      <h2 class="font-display text-2xl md:text-3xl font-extrabold text-white">Latest analysis</h2>
      <a href="/news" class="text-sm text-brand-400 font-medium hover:text-brand-300 shrink-0">All news →</a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {articles.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>

  <!-- NEWSLETTER ---------------------------------------------------------->
  <section class="mx-auto max-w-4xl px-4 pb-8">
    <Newsletter />
  </section>

  <!-- TELEGRAM CTA -------------------------------------------------------->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <div class="rounded-3xl bg-gradient-to-br from-brand-600/20 to-slate-900 border border-brand-500/30 p-8 md:p-12 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-extrabold text-white">Get every tip first on Telegram</h2>
      <p class="mt-3 text-slate-300 max-w-xl mx-auto">Join thousands of members getting our best bets live during the day — free.</p>
      <a href={SITE.telegram} class="mt-6 inline-flex font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-6 py-3 rounded-xl transition">
        Join the free channel →
      </a>
      <p class="mt-4 text-[11px] text-slate-500">Past results do not guarantee future returns. {SITE.minAge}+ · Play responsibly.</p>
    </div>
  </section>
</Base>
