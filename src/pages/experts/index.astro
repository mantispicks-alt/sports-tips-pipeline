---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const authors = await getCollection('authors');
---

<Base title="Our Experts" description="Meet the analysts behind the site's predictions and reviews — real people with real credentials.">
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Our experts</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">Real analysts, real track records. Every prediction is attributed — no anonymous content here.</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        authors.map((entry) => {
          const a = entry.data;
          const initials = a.name.split(' ').map((w) => w[0]).join('');
          return (
            <a href={`/experts/${entry.id}`} class="card rounded-2xl p-6 flex items-start gap-4 transition">
              <span class="w-14 h-14 rounded-2xl grid place-items-center text-slate-950 font-display font-extrabold text-lg shrink-0" style={`background:${a.accent}`}>
                {initials}
              </span>
              <div>
                <h2 class="font-display font-bold text-white">{a.name}</h2>
                <p class="text-sm text-brand-400">{a.role}</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {a.expertise.map((e) => <span class="text-[11px] text-slate-300 border border-slate-700 rounded px-2 py-0.5">{e}</span>)}
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</Base>
