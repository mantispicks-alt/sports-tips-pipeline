---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import OfferCard from '../components/OfferCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import GeoBar from '../components/GeoBar.astro';
import { SITE } from '../config';

const bookmakers = (await getCollection('bookmakers'))
  .filter((b) => b.data.type === 'sportsbook')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Best Betting Bonuses & Free Bets"
  description="The best licensed bookmaker welcome bonuses and free bets in Europe, ranked and reviewed by the site."
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-slate-800/60">
    <div class="pointer-events-none absolute inset-0 grid-scan opacity-70"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-12 md:py-16">
      <p class="hud text-gold">Free bets // licensed bookmakers</p>
      <h1 class="mt-3 font-display text-4xl md:text-5xl font-black text-white">
        Free Bets &amp; <span class="text-gold text-glow">Welcome Bonuses</span>
      </h1>
      <p class="mt-4 text-slate-300 max-w-2xl">
        Every offer below is from a licensed operator and updated regularly. Always read the full terms —
        wagering requirements and minimum odds apply.
      </p>
      <div class="mt-4 flex items-start gap-2 text-xs text-slate-400 border border-slate-800 rounded-xl p-3 max-w-2xl">
        <span class="text-brand-400">📍</span>
        <span>
          Offers and available operators depend on your country's regulations. Only bet with brands licensed in your
          jurisdiction. {SITE.minAge}+ · Gamble responsibly.
        </span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <!-- Comparison table -->
    <h2 class="font-display text-xl font-bold text-white mt-10 mb-4">Quick compare</h2>
    <ComparisonTable />

    <!-- Offer cards -->
    <h2 class="font-display text-xl font-bold text-white mt-12 mb-4">All offers</h2>
    <GeoBar />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {bookmakers.map((entry, i) => <OfferCard entry={entry} rank={i + 1} />)}
    </div>

    <div class="mt-10 card rounded-2xl p-6 text-sm text-slate-400 leading-relaxed">
      <p class="font-semibold text-white mb-2">How we rank offers</p>
      We weigh the real value of each bonus (not just the headline number), wagering requirements, withdrawal
      speed, market coverage and licensing. We may earn a commission when you sign up through our links — this
      never affects our rankings or the price you get.
    </div>
  </section>
</Base>
