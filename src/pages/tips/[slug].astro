---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stars from '../../components/Stars.astro';
import TipCard from '../../components/TipCard.astro';
import Byline from '../../components/Byline.astro';
import { TIER_LABEL } from '../../lib/tiers';

export async function getStaticPaths() {
  const tips = await getCollection('tips');
  return tips.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const t = entry.data;
const { Content } = await render(entry);

const all = await getCollection('tips');
const related = all.filter((x) => x.id !== entry.id && x.data.sport === t.sport).slice(0, 3);

const [homeTeam, awayTeam] = t.match.split(/\s+vs\.?\s+/i);

const sportIcon: Record<string, string> = { football: '⚽', basketball: '🏀', tennis: '🎾' };
const isPaid = t.tier !== 'free';
const isSettled = t.result !== 'pending';
// A paid pick that has already settled reveals its full detail (public record).
// A paid pick that is still upcoming is gated behind the paywall.
const gated = isPaid && !isSettled;

const kickoff = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long', day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit',
}).format(t.kickoff);

const resultStyle: Record<string, string> = {
  pending: 'bg-slate-700/40 text-slate-300',
  won: 'bg-brand-500/15 text-brand-400',
  lost: 'bg-rose-500/15 text-rose-400',
  void: 'bg-amber-500/15 text-amber-400',
};

const sportSchemaType: Record<string, string> = {
  football: 'SoccerEvent',
  basketball: 'SportsEvent',
  tennis: 'SportsEvent',
};
const sportCrumb: Record<string, string> = {
  football: 'Football tips',
  basketball: 'Basketball tips',
  tennis: 'Tennis tips',
};
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Predictions', href: '/tips' },
  { name: sportCrumb[t.sport] ?? 'Predictions', href: '/tips' },
  { name: t.match, href: `/tips/${entry.id}` },
];
const eventLd = homeTeam && awayTeam ? {
  '@context': 'https://schema.org',
  '@type': sportSchemaType[t.sport] ?? 'SportsEvent',
  name: `${homeTeam} vs ${awayTeam}`,
  description: gated
    ? `${t.league} match — subscription-only prediction from the site.`
    : `${t.league} match — ${t.market} tip: ${t.pick} @ ${t.odds}.`,
  startDate: new Date(t.kickoff).toISOString(),
  eventStatus: t.result === 'pending' ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventCompleted',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: t.league },
  competitor: [
    { '@type': 'SportsTeam', name: homeTeam.trim() },
    { '@type': 'SportsTeam', name: awayTeam.trim() },
  ],
  organizer: { '@type': 'Organization', name: t.league },
} : null;

// Public description never leaks the exact pick for gated content.
const publicDescription = gated
  ? `${t.match} (${t.league}) — ${TIER_LABEL[t.tier]} prediction. Unlock the full pick with a the site subscription.`
  : `${t.match} (${t.league}) — betting prediction and analysis. Free from the site.`;
---

<Base
  title={`${t.match} Prediction`}
  description={publicDescription}
  noindex={isPaid}
  breadcrumbs={crumbs}
>
  {eventLd && <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />}
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a href="/tips" class="text-sm text-brand-400">← All predictions</a>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-slate-400">
        <span>{sportIcon[t.sport] ?? '🏆'}</span>{t.league}
      </span>
      <span class="text-slate-700">·</span>
      <span class:list={['font-mono text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded', resultStyle[t.result]]}>{t.result}</span>
      {isPaid && (
        <span class:list={['font-mono text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded border', t.tier === 'vip' ? 'text-gold border-gold/50 bg-gold/10' : 'text-brand-400 border-brand-500/40 bg-brand-500/10']}>
          {TIER_LABEL[t.tier]}
        </span>
      )}
    </div>
    <h1 class="mt-2 font-display text-3xl md:text-4xl font-black text-white">{t.match}</h1>
    <p class="mt-1 flex items-center gap-2 font-mono text-sm text-slate-400">
      <svg viewBox="0 0 24 24" class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {kickoff}
    </p>
    {t.author && <div class="mt-4"><Byline slug={t.author} /></div>}

    {gated ? (
      <>
        <!-- Paywall — public visitors never see the pick/odds/analysis of a paid upcoming tip -->
        <section class="mt-6 rounded-2xl border-2 border-gold/40 bg-gradient-to-br from-gold/[0.08] to-slate-900/60 p-6 sm:p-8">
          <div class="flex items-start gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-gold/20 text-gold text-xl shrink-0">🔒</span>
            <div class="flex-1">
              <p class="font-mono text-[10px] uppercase tracking-wider text-gold">{TIER_LABEL[t.tier]} pick</p>
              <h2 class="mt-1 font-display text-xl md:text-2xl font-black text-white">Prediction locked</h2>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">
                This is a <strong class="text-gold">{TIER_LABEL[t.tier]}</strong> pick. Subscribe to unlock the full analysis, the market, the exact selection and the odds we're taking.
              </p>
            </div>
          </div>

          <div class="mt-5 grid grid-cols-3 gap-3">
            <div class="rounded-xl bg-slate-950/60 border border-slate-800 p-3 text-center">
              <p class="text-[10px] uppercase text-slate-500">Market</p>
              <p class="mt-1 text-white font-semibold select-none blur-sm">•••</p>
            </div>
            <div class="rounded-xl bg-slate-950/60 border border-slate-800 p-3 text-center">
              <p class="text-[10px] uppercase text-slate-500">Pick</p>
              <p class="mt-1 text-brand-400 font-semibold select-none blur-sm">••••</p>
            </div>
            <div class="rounded-xl bg-slate-950/60 border border-slate-800 p-3 text-center">
              <p class="text-[10px] uppercase text-slate-500">Odds</p>
              <p class="mt-1 font-display text-2xl font-extrabold text-white select-none blur-sm">•.••</p>
            </div>
          </div>

          <div class="mt-5 flex flex-col sm:flex-row gap-3">
            <a href="/pricing" class="flex-1 text-center font-bold text-slate-950 bg-gold hover:brightness-110 rounded-xl px-5 py-3 transition">
              Unlock {TIER_LABEL[t.tier]} →
            </a>
            <a href="/tips" class="flex-1 text-center font-semibold text-white border border-slate-700 hover:border-brand-500 rounded-xl px-5 py-3 transition">
              See free picks
            </a>
          </div>
          <p class="mt-3 text-[11px] text-slate-500 text-center">
            {TIER_LABEL[t.tier]} membership includes every settled pick's full record — see track record on <a class="text-brand-400 underline" href="/results">/results</a>.
          </p>
        </section>

        <p class="mt-6 text-sm text-slate-400 leading-relaxed">
          Every {TIER_LABEL[t.tier]} pick belongs to a strictly tracked disjoint band — WIN, OVERALL or ROI. Every settlement is public and every rule is auditable. See <a class="text-brand-400 underline" href="/methodology">how we produce picks</a>.
        </p>
      </>
    ) : (
      <>
        <div class="mt-6 card rounded-2xl p-6 grid grid-cols-3 gap-4 text-center">
          <div>
            <p class="text-[11px] uppercase text-slate-500">Market</p>
            <p class="text-white font-semibold mt-1">{t.market}</p>
          </div>
          <div>
            <p class="text-[11px] uppercase text-slate-500">Our pick</p>
            <p class="text-brand-400 font-semibold mt-1">{t.pick}</p>
          </div>
          <div>
            <p class="text-[11px] uppercase text-slate-500">Odds</p>
            <p class="font-display text-2xl font-extrabold text-white">{t.odds.toFixed(2)}</p>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-2 text-sm text-slate-400">
          Confidence: <Stars value={t.confidence} label />
        </div>

        <div class="prose prose-invert max-w-none mt-8 text-slate-300 leading-relaxed [&_h2]:font-display [&_h2]:text-white [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mt-6 [&_h2]:mb-2 [&_a]:text-brand-400 [&_strong]:text-white [&_blockquote]:text-slate-400 [&_blockquote]:border-l-2 [&_blockquote]:border-slate-700 [&_blockquote]:pl-4 [&_blockquote]:italic">
          <Content />
        </div>

        {t.bookmakerSlug && (
          <a
            href={`/bookmakers/${t.bookmakerSlug}`}
            class="mt-8 block text-center font-bold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-xl py-3.5 transition"
          >
            Bet this at {t.bookmaker} →
          </a>
        )}
        <p class="mt-3 text-center text-[11px] text-slate-500">18+ · Odds subject to change · Gamble responsibly</p>
      </>
    )}
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-16">
      <h2 class="font-display text-xl font-bold text-white mb-5">More {t.sport} tips</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => <TipCard entry={r} />)}
      </div>
    </section>
  )}
</Base>
