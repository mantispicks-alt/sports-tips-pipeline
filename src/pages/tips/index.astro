---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TipCard from '../../components/TipCard.astro';
import { dedupeByMatch } from '../../lib/dedupe';

const all = dedupeByMatch(await getCollection('tips')).sort((a, b) => +b.data.kickoff - +a.data.kickoff);
const now = Date.now();
// Upcoming = pending AND not yet kicked off (soonest first).
const upcoming = all
  .filter((t) => t.data.result === 'pending' && +t.data.kickoff > now)
  .sort((a, b) => +a.data.kickoff - +b.data.kickoff);
const settled = all.filter((t) => t.data.result === 'won' || t.data.result === 'lost');
const won = settled.filter((t) => t.data.result === 'won').length;
const winRate = settled.length ? Math.round((won / settled.length) * 100) : null;
// This is the PREDICTIONS page — show only upcoming (not-yet-kicked-off) picks.
// The full settled won/lost record lives on /results (kept the win-rate stat +
// a link below for proof). Showing the old finished matches here made the page
// read as "old matches" instead of actionable predictions.
const tips = upcoming;
const sports = ['all', ...new Set(tips.map((t) => t.data.sport))];
---

<Base title="Betting Predictions & Tips" description="Free daily football and basketball betting predictions with analysis, odds and confidence ratings.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Predictions & Tips</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">
      Free upcoming predictions, updated continuously. {winRate !== null && (
        <span>Settled win rate so far: <span class="text-brand-400 font-semibold">{winRate}%</span> ({won}/{settled.length}) — <a href="/results" class="text-brand-400 underline hover:text-brand-300">see the full tracked record</a>.</span>
      )}
    </p>

    <!-- Filter bar -->
    <div class="mt-6 flex flex-wrap gap-2" id="filterBar">
      {
        sports.map((s) => (
          <button
            data-filter={s}
            class:list={[
              'filter-btn text-sm px-4 py-1.5 rounded-full border transition capitalize',
              s === 'all'
                ? 'bg-brand-500 text-slate-950 border-brand-500'
                : 'text-slate-300 border-slate-700 hover:border-brand-500',
            ]}
          >
            {s}
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="tipGrid">
      {tips.map((entry) => (
        <div class="tip-item" data-sport={entry.data.sport}>
          <TipCard entry={entry} />
        </div>
      ))}
    </div>
    {tips.length === 0 && (
      <div class="mt-8 card rounded-xl p-6 text-slate-400 text-sm">
        No upcoming picks published right now — the next batch lands as fixtures and consensus come in. Meanwhile, see our <a href="/results" class="text-brand-400 underline">tracked results</a> and <a href="/value" class="text-brand-400 underline">sharp value spots</a>.
      </div>
    )}
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.tip-item');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => {
          b.classList.remove('bg-brand-500', 'text-slate-950', 'border-brand-500');
          b.classList.add('text-slate-300', 'border-slate-700');
        });
        btn.classList.add('bg-brand-500', 'text-slate-950', 'border-brand-500');
        btn.classList.remove('text-slate-300');
        items.forEach((it) => {
          it.style.display = f === 'all' || it.dataset.sport === f ? '' : 'none';
        });
      });
    });
  </script>
</Base>
