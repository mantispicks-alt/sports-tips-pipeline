---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stars from '../../components/Stars.astro';
import { COUNTRIES, isBookmakerAvailableIn, type Country } from '../../lib/countries';
import { SITE } from '../../config';

export async function getStaticPaths() {
  return COUNTRIES.map((country) => ({ params: { country: country.slug }, props: { country } }));
}

const { country } = Astro.props as { country: Country };
const bookmakers = (await getCollection('bookmakers'))
  .filter((b) => b.data.type === 'sportsbook')
  .filter((b) => isBookmakerAvailableIn(b.data.geos, b.data.restricted, country.code))
  .sort((a, b) => a.data.order - b.data.order);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Best bookmakers', href: '/bookmakers' },
  { name: country.displayEn, href: `/best-bookmakers/${country.slug}` },
];

// Rich card in results
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: bookmakers.slice(0, 10).map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.data.name,
    url: new URL(`/bookmakers/${b.id}`, Astro.site ?? SITE.url).href,
  })),
};
---

<Base
  title={`Best Betting Sites in ${country.displayEn} — Reviewed & Ranked`}
  description={`The best licensed sports betting sites for ${country.displayEn}, ranked on odds, bonuses and payout speed. ${country.regulator} regulated. ${SITE.minAge}+.`}
  breadcrumbs={crumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <p class="hud text-brand-400">{country.displayEn}</p>
        <h1 class="mt-1 font-display text-3xl md:text-4xl font-extrabold text-white">Best Betting Sites in {country.displayEn}</h1>
        <p class="mt-2 text-slate-400 max-w-2xl">{country.descEn}</p>
      </div>
      <div class="card rounded-xl px-4 py-3 text-right">
        <p class="hud hud-dim">Options</p>
        <p class="mt-1 font-mono text-xl font-bold text-white">{bookmakers.length}</p>
        <p class="mt-0.5 text-[10px] text-slate-500">available in {country.displayEn}</p>
      </div>
    </div>

    <div class="mt-10 space-y-4">
      {bookmakers.map((entry, i) => {
        const b = entry.data;
        return (
          <div class="card rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center gap-4">
            <span class="hidden sm:grid place-items-center w-7 h-7 rounded-full bg-gold/15 text-gold font-bold text-sm shrink-0">
              {i + 1}
            </span>
            <div class="w-12 h-12 rounded-xl grid place-items-center font-display font-extrabold text-slate-950 shrink-0" style={`background:${b.accent}`}>
              {(b.logoText ?? b.name).slice(0, 3)}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <h2 class="font-display font-bold text-white">{b.name}</h2>
                <Stars value={b.rating} />
                <span class="text-xs text-slate-400">{b.rating.toFixed(1)}</span>
                {b.licensed && <span class="text-[10px] text-brand-400 border border-brand-500/40 rounded px-1.5 py-0.5">Licensed</span>}
              </div>
              <p class="text-sm text-slate-400 mt-0.5">{b.bonus}</p>
            </div>
            <div class="flex gap-2 shrink-0">
              <a href={`/bookmakers/${entry.id}`} class="text-sm font-semibold text-slate-200 border border-slate-700 hover:border-brand-500 rounded-lg px-4 py-2">
                Review
              </a>
              <a href={b.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="text-sm font-bold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-lg px-4 py-2">
                Get bonus
              </a>
            </div>
          </div>
        );
      })}
    </div>

    {bookmakers.length === 0 && (
      <div class="mt-8 card rounded-xl p-6 text-slate-400 text-sm">
        No bookmakers we currently review are licensed in {country.displayEn}. See our <a href="/bookmakers" class="text-brand-400 underline">full bookmaker list</a>.
      </div>
    )}

    <div class="mt-14 card rounded-2xl p-6 leading-relaxed text-sm text-slate-300">
      <h2 class="font-display text-white text-lg font-bold mb-2">Responsible gambling in {country.displayEn}</h2>
      <p>
        The regulator in {country.displayEn} is <strong>{country.regulator}</strong>. If gambling is affecting your life, contact <strong>{country.helpline}</strong>. Full information on our <a href="/responsible-gambling" class="text-brand-400 underline">responsible gambling page</a>.
      </p>
      <p class="mt-3">
        {SITE.minAge}+ · Play responsibly · Odds and offers are subject to change — always check the operator's site before betting.
      </p>
    </div>
  </section>
</Base>
