---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import OfferCard from '../components/OfferCard.astro';
import GeoBar from '../components/GeoBar.astro';
import Mascot from '../components/Mascot.astro';
import { SITE } from '../config';

const casinos = (await getCollection('bookmakers'))
  .filter((b) => b.data.type === 'casino')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Best Online Casino Bonuses"
  description="Hand-picked, licensed online casino welcome bonuses and free spins — reviewed and ranked by the site."
>
  <section class="relative overflow-hidden border-b border-slate-800/60">
    <div class="pointer-events-none absolute inset-0 grid-scan opacity-70"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-12 md:py-16 text-center">
      <div class="flex justify-center"><Mascot size={120} /></div>
      <p class="mt-4 hud text-gold">Casino // licensed only</p>
      <h1 class="mt-3 font-display text-4xl md:text-5xl font-black text-white">Casino bonuses worth claiming</h1>
      <p class="mt-4 text-slate-300 max-w-2xl mx-auto">
        Slots, live tables and welcome packages from properly licensed casinos — ranked on real bonus value, wagering
        terms and withdrawal speed. Never on who pays us most.
      </p>
      <div class="mt-4 flex items-start gap-2 text-xs text-slate-400 border border-slate-800 rounded-xl p-3 max-w-2xl mx-auto text-left">
        <span class="text-gold">⚠</span>
        <span>
          Casino play is entertainment, not income, and carries real risk. Availability depends on your country's laws —
          only play with brands licensed in your jurisdiction. {SITE.minAge}+ · play responsibly.
        </span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <GeoBar />
    {
      casinos.length ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {casinos.map((entry, i) => <OfferCard entry={entry} rank={i + 1} />)}
        </div>
      ) : (
        <p class="text-slate-400">Casino partners are being added — check back shortly.</p>
      )
    }

    <div class="mt-10 card rounded-2xl p-6 text-sm text-slate-400 leading-relaxed">
      <p class="font-semibold text-white mb-2">How we rank casinos</p>
      We weigh the real value of each bonus against its wagering requirement, game selection, withdrawal speed and
      licensing. We may earn a commission when you sign up through our links — it never changes the offer you get or how
      we rank it.
    </div>
  </section>
</Base>
