---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TipCard from '../components/TipCard.astro';
import { dedupeByMatch } from '../lib/dedupe';

const all = dedupeByMatch(await getCollection('tips')).filter((t) => t.data.sport === 'football');
const now = Date.now();
const upcoming = all
  .filter((t) => t.data.result === 'pending' && +t.data.kickoff > now)
  .sort((a, b) => +a.data.kickoff - +b.data.kickoff);
const settled = all.filter((t) => t.data.result === 'won' || t.data.result === 'lost');
const won = settled.filter((t) => t.data.result === 'won').length;
const winRate = settled.length ? Math.round((won / settled.length) * 100) : null;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Predictions', href: '/tips' },
  { name: 'Football tips', href: '/football-tips' },
];
---

<Base
  title="Football Betting Tips & Predictions"
  description="Free daily football betting tips and predictions. Premier League, Champions League, La Liga, Serie A and more — with a public track record and best-odds guidance."
  breadcrumbs={crumbs}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Football Tips</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">
      Free upcoming football predictions — Premier League, La Liga, Serie A, Bundesliga, Ligue 1, Champions League and hundreds of other competitions.
      {winRate !== null && (
        <span> Football-only strike rate so far: <span class="text-brand-400 font-semibold">{winRate}%</span> ({won}/{settled.length}).</span>
      )}
      Full record on <a href="/results" class="text-brand-400 underline hover:text-brand-300">/results</a>.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {upcoming.map((entry) => (<TipCard entry={entry} />))}
    </div>
    {upcoming.length === 0 && (
      <div class="mt-8 card rounded-xl p-6 text-slate-400 text-sm">
        No upcoming football picks published right now — check back after the next update cycle, or see all picks on <a href="/tips" class="text-brand-400 underline">/tips</a>.
      </div>
    )}

    <div class="mt-14 card rounded-2xl p-6 leading-relaxed text-sm text-slate-300">
      <h2 class="font-display text-white text-lg font-bold mb-2">How our football picks are made</h2>
      <p>
        Every football tip on the site is generated by our proprietary consensus engine, which cross-checks multiple independent market and model signals against our own audited settled record before publishing. A pick only publishes when strict, deterministic audit rules are satisfied. Full methodology on <a href="/methodology" class="text-brand-400 underline">/methodology</a>.
      </p>
      <p class="mt-3">
        Every football pick is tracked publicly and settled from real match scores — no cherry-picking, no silent edits.
      </p>
    </div>
  </section>
</Base>
