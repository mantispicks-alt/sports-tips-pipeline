---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TipCard from '../components/TipCard.astro';
import { dedupeByMatch } from '../lib/dedupe';

const all = dedupeByMatch(await getCollection('tips')).filter((t) => t.data.sport === 'tennis');
const now = Date.now();
const upcoming = all
  .filter((t) => t.data.result === 'pending' && +t.data.kickoff > now)
  .sort((a, b) => +a.data.kickoff - +b.data.kickoff);
const settled = all.filter((t) => t.data.result === 'won' || t.data.result === 'lost');
const won = settled.filter((t) => t.data.result === 'won').length;
const winRate = settled.length ? Math.round((won / settled.length) * 100) : null;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Predictions', href: '/tips' },
  { name: 'Tennis tips', href: '/tennis-tips' },
];
---

<Base
  title="Tennis Betting Tips & Predictions"
  description="Free daily tennis betting tips and predictions — ATP, WTA and Grand Slams. Model-driven picks with real analysis and best odds."
  breadcrumbs={crumbs}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white">Tennis Tips</h1>
    <p class="text-slate-400 mt-2 max-w-2xl">
      Free upcoming tennis predictions from our multi-source consensus — ATP, WTA and Grand Slam matches.
      {winRate !== null && (
        <span> Tennis-only strike rate so far: <span class="text-brand-400 font-semibold">{winRate}%</span> ({won}/{settled.length}).</span>
      )}
      Full record on <a href="/results" class="text-brand-400 underline hover:text-brand-300">/results</a>.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {upcoming.map((entry) => (<TipCard entry={entry} />))}
    </div>
    {upcoming.length === 0 && (
      <div class="mt-8 card rounded-xl p-6 text-slate-400 text-sm">
        No upcoming tennis picks published right now — check back after the next 2-hour cycle, or see all sports on <a href="/tips" class="text-brand-400 underline">/tips</a>.
      </div>
    )}

    <div class="mt-14 card rounded-2xl p-6 leading-relaxed text-sm text-slate-300">
      <h2 class="font-display text-white text-lg font-bold mb-2">How our tennis picks are made</h2>
      <p>
        Every tennis tip cross-checks predictions from 70+ tipster sites and sharp price feeds. A pick publishes only when independent sources agree AND at least one has an audited edge in that odds band. Full pipeline on <a href="/methodology" class="text-brand-400 underline">Methodology</a>.
      </p>
    </div>
  </section>
</Base>
