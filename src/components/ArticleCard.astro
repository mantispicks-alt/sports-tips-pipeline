---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const a = entry.data;
const date = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).format(a.date);
---

<article class="card rounded-2xl p-5 flex flex-col gap-2 transition">
  <div class="flex items-center gap-2 text-[11px] uppercase tracking-wide text-slate-500">
    <span class="text-brand-400 font-semibold">{a.sport}</span>
    <span>·</span>
    <time>{date}</time>
  </div>
  <a href={`/news/${entry.id}`} class="font-display font-bold text-white hover:text-brand-400 transition leading-snug">
    {a.title}
  </a>
  <p class="text-sm text-slate-400 line-clamp-3">{a.description}</p>
  <a href={`/news/${entry.id}`} class="mt-auto text-sm text-brand-400 font-medium pt-2">Read more →</a>
</article>
