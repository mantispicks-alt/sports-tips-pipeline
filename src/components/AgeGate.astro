---
// 18+ Age Gate modal. Shows on first visit only (localStorage flag). Users
// confirm they're 18+ before browsing tips. Required for gambling-related
// content compliance across EU/UK/Cyprus jurisdictions. Copy switches per
// current locale so a Greek visitor never sees an English gate.
import { SITE } from '../config';
const path = Astro.url.pathname;
const isGreek = path.startsWith('/el/') || path === '/el';
const t = isGreek
  ? {
      header: 'Επαλήθευση Ηλικίας',
      subheader: 'Απαιτείται από τον νόμο',
      lead: `Αυτή η ιστοσελίδα περιέχει αθλητικές αναλύσεις και πληροφορίες προοριζόμενες μόνο για ενήλικες. Εισερχόμενοι επιβεβαιώνετε ότι έχετε τη νόμιμη ηλικία τζόγου στην περιοχή σας (${SITE.minAge}+).`,
      warn: 'Ο τζόγος μπορεί να προκαλέσει εθισμό. Παίξτε υπεύθυνα. Αν εσείς ή κάποιος γνωστός χρειάζεται βοήθεια, επικοινωνήστε με ',
      warnEnd: ' ή στην Κύπρο ',
      yes: `Είμαι ${SITE.minAge}+`,
      no: 'Έξοδος',
      helpline: '(Γραμμή 210 9237777)',
      kethea: 'ΚΕΘΕΑ',
    }
  : {
      header: 'Age Verification',
      subheader: 'Required by law',
      lead: `This site contains sports betting analytics and information intended for adults only. By entering, you confirm you are of legal gambling age in your jurisdiction (${SITE.minAge}+).`,
      warn: 'Gambling can be addictive. Please gamble responsibly. If you or someone you know needs help, contact ',
      warnEnd: ', or in Cyprus ',
      yes: `I am ${SITE.minAge}+`,
      no: 'Exit',
      helpline: '(Helpline 210 9237777)',
      kethea: 'KEΘΕΑ',
    };
---

<div id="age-gate" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/95 backdrop-blur-md p-4">
  <div class="max-w-md w-full bg-slate-950 border-2 border-brand-500/30 rounded-2xl p-6 shadow-2xl shadow-brand-500/10">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-12 h-12 rounded-full bg-brand-500/10 border border-brand-500/30 flex items-center justify-center">
        <span class="font-display font-black text-brand-400 text-lg">{SITE.minAge}+</span>
      </div>
      <div>
        <h2 class="font-display font-extrabold text-xl text-white">{t.header}</h2>
        <p class="text-xs text-slate-500 uppercase tracking-wider">{t.subheader}</p>
      </div>
    </div>
    <p class="text-slate-300 text-sm leading-relaxed mb-3">{t.lead}</p>
    <p class="text-xs text-slate-500 leading-relaxed mb-5">
      {t.warn}
      <a href="https://www.begambleaware.org/" target="_blank" rel="noopener" class="text-brand-400 underline">BeGambleAware</a>,
      <a href="https://www.gamcare.org.uk/" target="_blank" rel="noopener" class="text-brand-400 underline">GamCare</a>
      {t.warnEnd}
      <a href="https://www.kethea.gr/" target="_blank" rel="noopener" class="text-brand-400 underline">{t.kethea}</a> {t.helpline}.
    </p>
    <div class="grid grid-cols-2 gap-3">
      <button id="age-gate-yes" class="bg-brand-500 hover:bg-brand-400 text-slate-950 font-bold py-3 px-4 rounded-lg transition font-display">
        {t.yes}
      </button>
      <button id="age-gate-no" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold py-3 px-4 rounded-lg transition">
        {t.no}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const gate = document.getElementById('age-gate');
    if (!gate) return;
    try {
      const verified = localStorage.getItem('mp-age-verified');
      if (verified === '1') return; // already confirmed
    } catch (_) { /* localStorage blocked (private mode) — still show gate */ }
    gate.classList.remove('hidden');
    gate.classList.add('flex');
    document.body.style.overflow = 'hidden';
    document.getElementById('age-gate-yes')?.addEventListener('click', () => {
      try { localStorage.setItem('mp-age-verified', '1'); } catch (_) {}
      gate.classList.add('hidden');
      gate.classList.remove('flex');
      document.body.style.overflow = '';
    });
    document.getElementById('age-gate-no')?.addEventListener('click', () => {
      window.location.href = 'https://www.google.com';
    });
  })();
</script>
