---
import type { CollectionEntry } from 'astro:content';
import type { TierId } from '../config';
import { canView, TIER_LABEL } from '../lib/tiers';

interface Props {
  entry: CollectionEntry<'tips'>;
  userTier?: TierId; // Phase 1 default 'free' → paid picks render as locked funnel
}
const { entry, userTier = 'free' } = Astro.props;
const t = entry.data;
const locked = !canView(userTier, t.tier);

const sportIcon: Record<string, string> = { football: '⚽', basketball: '🏀', tennis: '🎾' };

const resultStyle: Record<string, string> = {
  pending: 'bg-slate-700/40 text-slate-300 border-slate-600/50',
  won: 'bg-brand-500/15 text-brand-400 border-brand-500/50',
  lost: 'bg-rose-500/15 text-rose-400 border-rose-500/50',
  void: 'bg-amber-500/15 text-amber-400 border-amber-500/50',
};

const kickoff = new Intl.DateTimeFormat('en-GB', {
  weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit',
}).format(t.kickoff);

const isVip = t.tier === 'vip';
---

{
  locked ? (
    <article class:list={['card group relative rounded-2xl p-5 flex flex-col gap-4 overflow-hidden', isVip ? 'card-gold' : '']}>
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400">
          <span>{sportIcon[t.sport] ?? '🏆'}</span>{t.league}
        </span>
        {t.result === 'won' || t.result === 'lost' ? (
          <span class:list={['font-mono text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md border', resultStyle[t.result]]}>
            {t.result}
          </span>
        ) : (
          <span class:list={['font-mono text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md border', isVip ? 'text-gold border-gold/50 bg-gold/10' : 'text-brand-400 border-brand-500/40 bg-brand-500/10']}>
            {TIER_LABEL[t.tier]}
          </span>
        )}
      </div>

      <p class="font-display font-bold text-lg text-white leading-snug">{t.match}</p>
      <p class="font-mono text-[11px] text-slate-500 -mt-2">{kickoff}</p>

      <!-- locked pick zone -->
      <div class="relative mt-1 rounded-xl border border-dashed border-slate-700/70 p-4 grid place-items-center text-center min-h-[92px]">
        <div class="select-none blur-[6px] opacity-40 font-mono text-2xl font-bold text-white">X.XX</div>
        <div class="absolute inset-0 grid place-items-center">
          <span class:list={['grid place-items-center w-9 h-10 hex', isVip ? 'bg-gold/15 text-gold' : 'bg-brand-500/15 text-brand-400']}>
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke-linecap="round"/></svg>
          </span>
        </div>
      </div>

      <a href="/pricing" class:list={['mt-1 text-center text-sm font-bold rounded-lg py-2.5 transition', isVip ? 'text-slate-950 bg-gold hover:brightness-110' : 'text-slate-950 bg-brand-500 hover:bg-brand-400']}>
        Unlock with {TIER_LABEL[t.tier]} →
      </a>
    </article>
  ) : (
    <article class="card group rounded-2xl p-5 flex flex-col gap-4 hover:-translate-y-1">
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400">
          <span>{sportIcon[t.sport] ?? '🏆'}</span>{t.league}
        </span>
        <span class:list={['font-mono text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md border', resultStyle[t.result]]}>
          {t.result}
        </span>
      </div>

      <div>
        <a href={`/tips/${entry.id}`} class="font-display font-bold text-lg text-white group-hover:text-brand-400 transition leading-snug">
          {t.match}
        </a>
        <p class="font-mono text-[11px] text-slate-500 mt-1">{kickoff}</p>
      </div>

      <div class="flex items-end justify-between gap-3 pt-1">
        <div class="min-w-0">
          <p class="hud hud-dim">Pick</p>
          <p class="text-brand-400 font-semibold truncate">{t.pick}</p>
          <p class="text-[11px] text-slate-500 mt-0.5">{t.market}</p>
          <div class="mt-2 flex items-center gap-1" aria-label={`Confidence ${t.confidence} of 5`} title={`Confidence ${t.confidence}/5`}>
            {Array.from({ length: 5 }).map((_, i) => <span class:list={['pip', i < t.confidence && 'on-gold']} />)}
          </div>
        </div>
        <div class="text-right shrink-0">
          <p class="hud hud-dim">Odds</p>
          <p class="font-mono text-3xl font-bold text-white leading-none">{t.odds.toFixed(2)}</p>
        </div>
      </div>

      {t.bookmakerSlug ? (
        <a href={`/bookmakers/${t.bookmakerSlug}`} class="mt-1 text-center text-sm font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-lg py-2.5 transition">
          Bet at {t.bookmaker ?? 'top bookmaker'} →
        </a>
      ) : (
        <a href={`/tips/${entry.id}`} class="mt-1 text-center text-sm font-semibold text-slate-200 border border-slate-700 hover:border-brand-500 hover:text-white rounded-lg py-2.5 transition">
          Read analysis →
        </a>
      )}
    </article>
  )
}
