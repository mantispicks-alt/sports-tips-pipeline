---
// Reusable mascot medallion — crops the real illustrated logo (the hooded
// mantis) into a hex-framed badge for moments the flat Logo.astro monogram
// is too small/abstract for: empty states, 404, section dividers.
interface Props {
  size?: number;
  class?: string;
  glow?: boolean;
}
const { size = 96, class: cls = '', glow = true } = Astro.props;
---

<span
  class:list={['relative inline-grid place-items-center shrink-0', cls]}
  style={`width:${size}px;height:${size * 1.02}px`}
>
  <svg viewBox="0 0 100 102" width="100%" height="100%" aria-hidden="true">
    <defs>
      <clipPath id={`mx-hex-${size}`}>
        <path d="M50 1 L96 24 L96 78 L50 101 L4 78 L4 24 Z" />
      </clipPath>
      <linearGradient id={`mx-ring-${size}`} x1="0" y1="0" x2="100" y2="102" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#9ee84b" />
        <stop offset="1" stop-color="#e7b73f" />
      </linearGradient>
    </defs>
    <g clip-path={`url(#mx-hex-${size})`}>
      <rect width="100" height="102" fill="#0b1109" />
      <image href="/logo.jpeg" x="-32" y="-6" width="164" height="114" preserveAspectRatio="xMidYMid slice" />
      <rect width="100" height="102" fill={`url(#mx-ring-${size})`} opacity="0.05" />
    </g>
    <path d="M50 1 L96 24 L96 78 L50 101 L4 78 L4 24 Z" fill="none" stroke={`url(#mx-ring-${size})`} stroke-width="2" />
  </svg>
  {glow && <span class="pointer-events-none absolute inset-0 hex" style="box-shadow: inset 0 0 24px rgba(158,232,75,0.25)" />}
</span>
