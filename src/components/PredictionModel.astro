---
import { predictMatch, impliedProb, valueEdge } from '../lib/poisson';

interface Props {
  homeTeam: string;
  awayTeam: string;
  homeScored: number;
  homeConceded: number;
  awayScored: number;
  awayConceded: number;
  leagueAvg?: number;
  odds?: number;
  valueMarket?: string;
}
const props = Astro.props;
const m = predictMatch({
  home: { scoredAvg: props.homeScored, concededAvg: props.homeConceded },
  away: { scoredAvg: props.awayScored, concededAvg: props.awayConceded },
  leagueAvgGoals: props.leagueAvg,
});

const marketProb = props.valueMarket ? ((m as unknown as Record<string, number>)[props.valueMarket] ?? null) : null;
const edge = props.valueMarket && props.odds && marketProb !== null ? valueEdge(marketProb, props.odds) : null;

const bars = [
  { label: `${props.homeTeam}`, v: m.home, c: 'bg-brand-500' },
  { label: 'Draw', v: m.draw, c: 'bg-slate-500' },
  { label: `${props.awayTeam}`, v: m.away, c: 'bg-sky-500' },
];
---

<section class="card rounded-2xl p-6">
  <div class="flex items-center justify-between">
    <h2 class="font-display font-bold text-white text-lg">📈 Our model</h2>
    <span class="text-xs text-slate-500">Poisson · xG {m.lambdaHome}–{m.lambdaAway}</span>
  </div>

  {
    edge !== null && marketProb !== null && (
      <div
        class:list={[
          'mt-4 rounded-xl p-3 text-sm flex items-center justify-between gap-3 border',
          edge > 0 ? 'border-brand-500/40 bg-brand-500/10 text-brand-300' : 'border-slate-700 bg-slate-800/40 text-slate-300',
        ]}
      >
        <span>Model rates the pick <strong>{marketProb}%</strong> vs <strong>{impliedProb(props.odds!)}%</strong> implied by the odds.</span>
        <span class="font-bold whitespace-nowrap">{edge > 0 ? `+${edge}% value` : `${edge}%`}</span>
      </div>
    )
  }

  <div class="mt-5 space-y-2.5">
    {
      bars.map((b) => (
        <div>
          <div class="flex justify-between text-xs text-slate-400 mb-1">
            <span>{b.label}</span>
            <span>{b.v}%</span>
          </div>
          <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
            <div class={`h-full ${b.c}`} style={`width:${b.v}%`} />
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
    <div class="rounded-xl bg-slate-800/40 p-3">
      <p class="text-xs text-slate-500">Over / Under 2.5</p>
      <p class="text-white mt-1">O <strong>{m.over25}%</strong> · U <strong>{m.under25}%</strong></p>
    </div>
    <div class="rounded-xl bg-slate-800/40 p-3">
      <p class="text-xs text-slate-500">Both teams to score</p>
      <p class="text-white mt-1">Yes <strong>{m.bttsYes}%</strong> · No <strong>{m.bttsNo}%</strong></p>
    </div>
  </div>

  <div class="mt-4">
    <p class="text-xs text-slate-500 mb-2">Most likely scores</p>
    <div class="flex flex-wrap gap-2">
      {
        m.topScores.map((s) => (
          <span class="text-xs border border-slate-700 rounded-lg px-2.5 py-1 text-slate-200">
            {s.score} <span class="text-slate-500">{s.prob}%</span>
          </span>
        ))
      }
    </div>
  </div>

  <p class="mt-4 text-[11px] text-slate-500">Model built from recent scoring form. Guidance only — not a guarantee.</p>
</section>
