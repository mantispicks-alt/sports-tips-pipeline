---
interface Props {
  points: { cum: number }[];
  height?: number;
}
const { points, height = 120 } = Astro.props;

const w = 600;
const h = height;
const pad = 8;
const xs = points.length > 1 ? points.length - 1 : 1;
const vals = points.map((p) => p.cum);
const min = Math.min(0, ...vals);
const max = Math.max(0, ...vals);
const range = max - min || 1;

const x = (i: number) => pad + (i / xs) * (w - 2 * pad);
const y = (v: number) => h - pad - ((v - min) / range) * (h - 2 * pad);

const line = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(p.cum).toFixed(1)}`).join(' ');
const area = points.length
  ? `${line} L${x(points.length - 1).toFixed(1)},${(h - pad).toFixed(1)} L${x(0).toFixed(1)},${(h - pad).toFixed(1)} Z`
  : '';
const zeroY = y(0).toFixed(1);
const last = points[points.length - 1]?.cum ?? 0;
const lastX = x(points.length - 1).toFixed(1);
const lastY = y(last).toFixed(1);
const stroke = last >= 0 ? '#9ee84b' : '#fb5d6a';
---

<svg viewBox={`0 0 ${w} ${h}`} class="w-full" preserveAspectRatio="none" role="img" aria-label="Cumulative profit over time">
  <defs>
    <linearGradient id="eqfill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={stroke} stop-opacity="0.32" />
      <stop offset="1" stop-color={stroke} stop-opacity="0" />
    </linearGradient>
    <filter id="eqglow" x="-20%" y="-40%" width="140%" height="180%">
      <feGaussianBlur stdDeviation="3.2" result="b" />
      <feMerge>
        <feMergeNode in="b" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <line x1="0" x2={w} y1={zeroY} y2={zeroY} stroke="#e7b73f" stroke-opacity="0.35" stroke-dasharray="3 4" stroke-width="1" />
  {area && <path d={area} fill="url(#eqfill)" />}
  {line && (
    <path
      d={line}
      fill="none"
      stroke={stroke}
      stroke-width="2.5"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
      filter="url(#eqglow)"
    />
  )}
  {points.length > 0 && <circle cx={lastX} cy={lastY} r="3.5" fill={stroke} filter="url(#eqglow)" />}
</svg>
