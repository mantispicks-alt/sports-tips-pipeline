---
import { predictBasketball } from '../lib/basketball';
import { impliedProb, valueEdge } from '../lib/poisson';

interface Props {
  homeTeam: string;
  awayTeam: string;
  homePointsFor: number;
  homePointsAgainst: number;
  awayPointsFor: number;
  awayPointsAgainst: number;
  leagueAvgPoints?: number;
  totalLine?: number;
  odds?: number;
  valueMarket?: string;
}
const p = Astro.props;
const m = predictBasketball({
  home: { pointsFor: p.homePointsFor, pointsAgainst: p.homePointsAgainst },
  away: { pointsFor: p.awayPointsFor, pointsAgainst: p.awayPointsAgainst },
  leagueAvgPoints: p.leagueAvgPoints,
  totalLine: p.totalLine,
});

const marketProb = p.valueMarket ? ((m as unknown as Record<string, number | null>)[p.valueMarket] ?? null) : null;
const edge = p.valueMarket && p.odds && marketProb != null ? valueEdge(marketProb, p.odds) : null;

const bars = [
  { label: p.homeTeam, v: m.homeWin, c: 'bg-brand-500' },
  { label: p.awayTeam, v: m.awayWin, c: 'bg-sky-500' },
];
---

<section class="card rounded-2xl p-6">
  <div class="flex items-center justify-between">
    <h2 class="font-display font-bold text-white text-lg">🏀 Our model</h2>
    <span class="text-xs text-slate-500">Projected {m.projHome}–{m.projAway}</span>
  </div>

  {
    edge != null && marketProb != null && (
      <div
        class:list={[
          'mt-4 rounded-xl p-3 text-sm flex items-center justify-between gap-3 border',
          edge > 0 ? 'border-brand-500/40 bg-brand-500/10 text-brand-300' : 'border-slate-700 bg-slate-800/40 text-slate-300',
        ]}
      >
        <span>Model rates the pick <strong>{marketProb}%</strong> vs <strong>{impliedProb(p.odds!)}%</strong> implied by the odds.</span>
        <span class="font-bold whitespace-nowrap">{edge > 0 ? `+${edge}% value` : `${edge}%`}</span>
      </div>
    )
  }

  <div class="mt-5 space-y-2.5">
    {
      bars.map((b) => (
        <div>
          <div class="flex justify-between text-xs text-slate-400 mb-1">
            <span>{b.label}</span>
            <span>{b.v}%</span>
          </div>
          <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
            <div class={`h-full ${b.c}`} style={`width:${b.v}%`} />
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
    <div class="rounded-xl bg-slate-800/40 p-3">
      <p class="text-xs text-slate-500">Projected total</p>
      <p class="text-white mt-1 font-semibold">{m.total} pts</p>
    </div>
    {
      m.over != null ? (
        <div class="rounded-xl bg-slate-800/40 p-3">
          <p class="text-xs text-slate-500">Total vs {p.totalLine}</p>
          <p class="text-white mt-1">O <strong>{m.over}%</strong> · U <strong>{m.under}%</strong></p>
        </div>
      ) : (
        <div class="rounded-xl bg-slate-800/40 p-3">
          <p class="text-xs text-slate-500">Projected margin</p>
          <p class="text-white mt-1 font-semibold">{m.margin > 0 ? '+' : ''}{m.margin}</p>
        </div>
      )
    }
  </div>

  <p class="mt-4 text-[11px] text-slate-500">Model from scoring/defence form (normal approximation). Guidance only — not a guarantee.</p>
</section>
