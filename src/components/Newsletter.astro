---
import { SITE } from '../config';
---

<section class="relative rounded-3xl card p-8 text-center overflow-hidden">
  <div class="pointer-events-none absolute inset-0 grid-scan opacity-50"></div>
  <p class="relative hud text-gold">Daily edge</p>
  <h2 class="relative mt-2 font-display text-2xl md:text-3xl font-black text-white">The day's best bets, in your inbox</h2>
  <p class="relative mt-2 text-slate-400">One short email a day — the top picks and the biggest value spots. No spam, ever.</p>

  <form class="relative mt-6 flex flex-col sm:flex-row gap-3 max-w-md mx-auto" data-newsletter action="#" method="post">
    <input
      type="email"
      required
      placeholder="you@email.com"
      aria-label="Email address"
      class="flex-1 rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white placeholder:text-slate-600 focus:border-brand-500 outline-none transition"
    />
    <button type="submit" class="font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-xl px-5 py-3 transition">
      Subscribe
    </button>
  </form>
  <p class="relative mt-3 font-mono text-[10px] tracking-wide text-slate-500">By subscribing you confirm you are {SITE.minAge}+ · Unsubscribe anytime</p>

  <script>
    document.querySelector('[data-newsletter]')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      f.innerHTML = '<p class="text-brand-400 font-semibold py-3">Locked in. Check your inbox to confirm. ✅</p>';
    });
  </script>
</section>
