---
import { SITE, NAV } from '../config';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
const isGreek = path.startsWith('/el/') || path === '/el';
const strip = path.replace(/^\/el(\/|$)/, '/');
const enHref = strip.startsWith('/') ? strip : `/${strip}`;
const elHref = isGreek ? path : (enHref === '/' ? '/el/' : `/el${enHref}`);

// Greek nav labels (mirrors NAV order). Only the labels that lead to pages we
// actually shipped a /el copy of are rewritten to point under /el.
const EL_LABELS: Record<string, string> = {
  Predictions: 'Προβλέψεις',
  Value: 'Value',
  VIP: 'VIP',
  Results: 'Αποτελέσματα',
  'Free Bets': 'Προσφορές',
  Casino: 'Casino',
  News: 'Νέα',
};
const EL_HREFS: Record<string, string> = {
  '/tips': '/el/tips',
  '/pricing': '/el/pricing',
  '/results': '/el/results',
  '/value': '/el/value',
  '/news': '/el/news',
  // Other targets fall through to English for now.
};
const localizedNav = NAV.map((n) => ({
  label: isGreek ? (EL_LABELS[n.label] ?? n.label) : n.label,
  href: isGreek ? (EL_HREFS[n.href] ?? n.href) : n.href,
}));
const homeHref = isGreek ? '/el/' : '/';
const telegramCta = isGreek ? 'Join Telegram' : 'Join Telegram';
const picksLive = isGreek ? 'Picks live' : 'Picks live';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/75 border-b border-slate-800/70">
  <!-- premium hairline: green → gold -->
  <div class="h-px w-full bg-gradient-to-r from-brand-500/0 via-brand-500/60 to-gold/40"></div>

  <div class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
    <a href={homeHref} class="group flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <span class="relative grid place-items-center transition-transform duration-300 group-hover:scale-105">
        <Logo size={34} />
      </span>
      <span class="font-display font-extrabold text-lg tracking-tight text-white leading-none">
        {SITE.name}
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-sm">
      {
        localizedNav.map((n) => (
          <a
            href={n.href}
            class:list={[
              'relative py-1 font-medium transition-colors',
              isActive(n.href) ? 'text-brand-400' : 'text-slate-300 hover:text-white',
            ]}
          >
            {n.label}
            <span
              class:list={[
                'absolute -bottom-0.5 left-0 h-px bg-brand-400 transition-all duration-300',
                isActive(n.href) ? 'w-full' : 'w-0',
              ]}
            />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:inline-flex items-center gap-0.5 font-mono text-[10px] uppercase tracking-wider" aria-label="Language">
        <a href={enHref} class:list={['px-1.5 py-0.5 rounded transition', !isGreek ? 'text-brand-400 bg-brand-500/10' : 'text-slate-500 hover:text-slate-300']}>EN</a>
        <span class="text-slate-700">/</span>
        <a href={elHref} class:list={['px-1.5 py-0.5 rounded transition', isGreek ? 'text-brand-400 bg-brand-500/10' : 'text-slate-500 hover:text-slate-300']}>EL</a>
      </div>
      <span class="hidden lg:inline-flex items-center gap-1.5 font-mono text-[10px] tracking-[0.14em] uppercase text-slate-400">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400 live-dot"></span>
        Picks live
      </span>
      <a
        href={SITE.telegram}
        class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 px-3.5 py-2 rounded-lg transition glow"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true"
          ><path d="M9.8 15.6 9.6 19c.4 0 .5-.2.8-.4l1.9-1.8 3.9 2.9c.7.4 1.2.2 1.4-.7l2.6-12.1c.2-1-.4-1.5-1.1-1.2L3.4 10.4c-1 .4-1 1-.2 1.2l4 1.3 9.4-5.9c.4-.3.8-.1.5.2z"
        /></svg>
        Join Telegram
      </a>
      <button
        id="navToggle"
        class="md:hidden grid place-items-center w-9 h-9 rounded-lg border border-slate-700 text-slate-200 hover:border-brand-500 transition"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span class="text-lg leading-none">☰</span>
      </button>
    </div>
  </div>

  <nav id="mobileNav" class="hidden md:hidden border-t border-slate-800/70 px-4 py-3 bg-slate-950/95 backdrop-blur">
    {
      localizedNav.map((n) => (
        <a
          href={n.href}
          class:list={[
            'flex items-center gap-2.5 py-2.5 text-sm',
            isActive(n.href) ? 'text-brand-400' : 'text-slate-300',
          ]}
        >
          <span class="pip hex-flat shrink-0" style="width:.55rem;height:.62rem" />
          {n.label}
        </a>
      ))
    }
    <a href={SITE.telegram} class="mt-2 flex justify-center font-semibold text-slate-950 bg-brand-500 rounded-lg py-2.5">
      {isGreek ? 'Δωρεάν Telegram κανάλι →' : 'Join the free Telegram →'}
    </a>
  </nav>

  <script>
    const btn = document.getElementById('navToggle');
    const menu = document.getElementById('mobileNav');
    btn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
  </script>
</header>
