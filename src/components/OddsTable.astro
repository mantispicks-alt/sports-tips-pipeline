---
import { getCollection } from 'astro:content';
import { valueEdge } from '../lib/poisson';
import { SITE } from '../config';

interface Row {
  book: string;
  slug?: string;
  odds: number;
  payout?: number; // book payout % (public)
  commission?: number; // affiliate % — ADMIN ONLY, intentionally never rendered here
}
interface Props {
  rows: Row[];
  pick: string;
  modelProb?: number; // model probability (%) for the tipped selection → powers value %
}
const { rows, pick, modelProb } = Astro.props;

const books = await getCollection('bookmakers');
const bookData = (slug?: string) => books.find((b) => b.id === slug)?.data;

const sorted = [...rows].sort((a, b) => b.odds - a.odds);
const best = sorted[0]?.odds;
const showPayout = sorted.some((r) => typeof r.payout === 'number');
const showValue = typeof modelProb === 'number';
---

<section class="card rounded-2xl overflow-hidden">
  <div class="p-5 sm:p-6 border-b border-slate-800/60">
    <p class="hud text-gold">Where to back it</p>
    <h2 class="mt-1 font-display font-black text-white text-xl">{pick}</h2>
    <p class="mt-1 text-xs text-slate-500">
      Same bet, live prices from licensed books. Highest odds = biggest payout — we sort best first.
    </p>
  </div>

  <!-- column header -->
  <div class="hidden sm:grid grid-cols-[1.6fr_repeat(3,minmax(0,1fr))_auto] gap-3 px-6 py-2 border-b border-slate-800/50 font-mono text-[10px] uppercase tracking-wider text-slate-500">
    <span>Bookmaker</span>
    <span class="text-right">{showValue ? 'Edge' : ''}</span>
    <span class="text-right">{showPayout ? 'Payout' : ''}</span>
    <span class="text-right">Odds</span>
    <span class="text-right">Back</span>
  </div>

  <div class="divide-y divide-slate-800/50">
    {
      sorted.map((r, i) => {
        const b = bookData(r.slug);
        const edge = showValue ? valueEdge(modelProb!, r.odds) : null;
        const isBest = r.odds === best;
        return (
          <div class:list={['grid grid-cols-[1.6fr_repeat(3,minmax(0,1fr))_auto] gap-3 items-center px-5 sm:px-6 py-3', isBest && 'bg-brand-500/[0.06]']}>
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="hidden sm:grid place-items-center w-6 h-7 hex bg-slate-800 text-slate-500 font-mono text-[11px]">{i + 1}</span>
              {b ? (
                <span class="shrink-0 w-8 h-8 rounded-lg grid place-items-center font-display font-extrabold text-[11px] text-slate-950" style={`background:${b.accent}`}>
                  {(b.logoText ?? b.name).slice(0, 3)}
                </span>
              ) : null}
              <div class="min-w-0">
                <span class="block text-sm font-semibold text-white truncate">{r.book}</span>
                {isBest && <span class="font-mono text-[9px] uppercase tracking-wider text-gold">Best price</span>}
              </div>
            </div>

            <div class="text-right">
              {edge != null && (
                <span class:list={['font-mono text-sm font-bold', edge >= 0 ? 'text-brand-400' : 'text-slate-500']}>
                  {edge >= 0 ? '+' : ''}{edge}%
                </span>
              )}
            </div>

            <div class="text-right font-mono text-sm text-slate-300">
              {typeof r.payout === 'number' ? `${r.payout}%` : ''}
            </div>

            <div class="text-right">
              <span class:list={['font-mono font-bold', isBest ? 'text-brand-400 text-xl' : 'text-white text-lg']}>
                {r.odds.toFixed(2)}
              </span>
            </div>

            <div class="text-right">
              <a
                href={b?.affiliateUrl ?? '#'}
                target="_blank"
                rel="sponsored nofollow noopener"
                class:list={[
                  'inline-flex text-xs font-bold rounded-lg px-3.5 py-2 transition',
                  isBest ? 'text-slate-950 bg-brand-500 hover:bg-brand-400' : 'text-white border border-slate-700 hover:border-brand-500',
                ]}
              >
                Back it →
              </a>
            </div>
          </div>
        );
      })
    }
  </div>

  <p class="px-5 sm:px-6 py-3 border-t border-slate-800/50 font-mono text-[10px] text-slate-500">
    {SITE.minAge}+ · T&amp;Cs apply · odds change — confirm on the operator's site · we may earn commission (never affects the price you get)
  </p>
</section>
