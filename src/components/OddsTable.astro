---
import { getCollection } from 'astro:content';

interface Row {
  book: string;
  slug?: string;
  odds: number;
}
interface Props {
  rows: Row[];
  pick: string;
}
const { rows, pick } = Astro.props;

const books = await getCollection('bookmakers');
const urlFor = (slug?: string) => books.find((b) => b.id === slug)?.data.affiliateUrl ?? '#';

const sorted = [...rows].sort((a, b) => b.odds - a.odds);
const best = sorted[0]?.odds;
---

<section class="card rounded-2xl p-6">
  <h2 class="font-display font-bold text-white text-lg">⚖️ Best odds — {pick}</h2>
  <p class="text-xs text-slate-500 mt-1">Same bet, different prices. Always take the highest — it pays more.</p>

  <div class="mt-4 divide-y divide-slate-800/60">
    {
      sorted.map((r) => (
        <div class="flex items-center justify-between py-3">
          <span class="text-sm text-slate-200 font-medium">{r.book}</span>
          <div class="flex items-center gap-3">
            {r.odds === best && (
              <span class="text-[10px] uppercase font-bold text-brand-400 border border-brand-500/40 rounded px-1.5 py-0.5">Best</span>
            )}
            <span class:list={['font-display font-bold w-14 text-right', r.odds === best ? 'text-brand-400 text-xl' : 'text-white']}>
              {r.odds.toFixed(2)}
            </span>
            <a
              href={urlFor(r.slug)}
              target="_blank"
              rel="sponsored nofollow noopener"
              class="text-xs font-semibold text-slate-950 bg-brand-500 hover:bg-brand-400 rounded-lg px-3 py-1.5"
            >
              Bet
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-3 text-[10px] text-slate-500">18+ · T&Cs apply · Odds change — confirm on the operator's site.</p>
</section>
