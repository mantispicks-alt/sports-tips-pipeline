---
import { SITE, NAV } from '../config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const isGreek = path.startsWith('/el/') || path === '/el';

const EL_NAV_LABEL: Record<string, string> = {
  Predictions: 'Προβλέψεις',
  Value: 'Value',
  VIP: 'VIP',
  Results: 'Αποτελέσματα',
  'Free Bets': 'Προσφορές',
  Casino: 'Casino',
  News: 'Νέα',
};
const EL_NAV_HREF: Record<string, string> = {
  '/tips': '/el/tips',
  '/pricing': '/el/pricing',
};
const localizedNav = NAV.map((n) => ({
  label: isGreek ? (EL_NAV_LABEL[n.label] ?? n.label) : n.label,
  href: isGreek ? (EL_NAV_HREF[n.href] ?? n.href) : n.href,
}));

// Translated static links (only where a Greek page actually exists).
const links = isGreek
  ? {
      explore: 'Εξερεύνηση',
      calculators: 'Betting calculators',
      calculatorsHref: '/tools',
      howVet: 'Πώς επιλέγουμε σήματα',
      howVetHref: '/el/tipsters',
      howPredict: 'Πώς προβλέπουμε',
      howPredictHref: '/el/methodology',
      experts: 'Οι ειδικοί μας',
      expertsHref: '/experts',
      glossary: 'Λεξικό στοιχήματος',
      glossaryHref: '/el/glossary',
      faq: 'FAQ',
      faqHref: '/el/faq',
      contact: 'Επικοινωνία',
      contactHref: '/el/contact',
      bySport: 'Ανά άθλημα',
      football: 'Ποδόσφαιρο',
      footballHref: '/football-tips',
      valuePicks: 'Value picks',
      valuePicksHref: '/value',
      allLeagues: 'Όλες οι λίγκες',
      allLeaguesHref: '/leagues',
      legal: 'Νομικά & Ασφάλεια',
      responsible: 'Υπεύθυνο Παιχνίδι',
      responsibleHref: '/el/responsible-gambling',
      privacy: 'Πολιτική Απορρήτου',
      privacyHref: '/el/privacy-policy',
      terms: 'Όροι Χρήσης',
      termsHref: '/el/terms',
      about: 'Σχετικά',
      aboutHref: '/el/about',
      rights: 'Όλα τα δικαιώματα διατηρούνται.',
      disclaimer: `Το ${SITE.name} παρέχει πληροφορίες και γνώμη μόνο για ψυχαγωγικούς σκοπούς. Δεν είμαστε bookmaker και δεν δεχόμαστε στοιχήματα. Όλες οι αποδόσεις και προσφορές υπόκεινται σε αλλαγή — πάντα ελέγξτε τους όρους του παρόχου.`,
    }
  : {
      explore: 'Explore',
      calculators: 'Betting calculators',
      calculatorsHref: '/tools',
      howVet: 'How we vet signals',
      howVetHref: '/tipsters',
      howPredict: 'How we predict',
      howPredictHref: '/methodology',
      experts: 'Our experts',
      expertsHref: '/experts',
      glossary: 'Betting glossary',
      glossaryHref: '/glossary',
      faq: 'FAQ',
      faqHref: '/faq',
      contact: 'Contact',
      contactHref: '/contact',
      bySport: 'By sport',
      football: 'Football tips',
      footballHref: '/football-tips',
      valuePicks: 'Value picks',
      valuePicksHref: '/value',
      allLeagues: 'All leagues',
      allLeaguesHref: '/leagues',
      legal: 'Legal & Safety',
      responsible: 'Responsible Gambling',
      responsibleHref: '/responsible-gambling',
      privacy: 'Privacy Policy',
      privacyHref: '/privacy-policy',
      terms: 'Terms of Use',
      termsHref: '/terms',
      about: 'About Us',
      aboutHref: '/about',
      rights: 'All rights reserved.',
      disclaimer: `${SITE.name} provides information and opinion for entertainment only. We are not a bookmaker and do not take bets. All odds and offers are subject to change — always check the operator's terms.`,
    };
---

<footer class="relative border-t border-slate-800/60 bg-slate-950/60 mt-20">
  <div class="h-px w-full bg-gradient-to-r from-gold/30 via-brand-500/50 to-brand-500/0"></div>
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2.5 font-display font-extrabold text-lg text-white">
        <Logo size={32} />
        <span><span class="text-brand-400">Mantis</span>Picks</span>
      </div>
      <p class="mt-3 text-sm text-slate-400 max-w-sm">{SITE.description}</p>
      <p class="mt-4 text-xs text-slate-500 leading-relaxed">{links.disclaimer}</p>
    </div>

    <div>
      <h4 class="text-sm font-semibold text-white mb-3">{links.explore}</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        {localizedNav.map((n) => <li><a href={n.href} class="hover:text-brand-400">{n.label}</a></li>)}
        <li><a href={links.calculatorsHref} class="hover:text-brand-400">{links.calculators}</a></li>
        <li><a href={links.howVetHref} class="hover:text-brand-400">{links.howVet}</a></li>
        <li><a href={links.howPredictHref} class="hover:text-brand-400">{links.howPredict}</a></li>
        <li><a href={links.expertsHref} class="hover:text-brand-400">{links.experts}</a></li>
        <li><a href={links.glossaryHref} class="hover:text-brand-400">{links.glossary}</a></li>
        <li><a href={links.faqHref} class="hover:text-brand-400">{links.faq}</a></li>
        <li><a href={links.contactHref} class="hover:text-brand-400">{links.contact}</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold text-white mb-3">{links.bySport}</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href={links.footballHref} class="hover:text-brand-400">{links.football}</a></li>
        <li><a href={links.valuePicksHref} class="hover:text-brand-400">{links.valuePicks}</a></li>
        <li><a href={links.allLeaguesHref} class="hover:text-brand-400">{links.allLeagues}</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold text-white mb-3">{links.legal}</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href={links.responsibleHref} class="hover:text-brand-400">{links.responsible}</a></li>
        <li><a href={links.privacyHref} class="hover:text-brand-400">{links.privacy}</a></li>
        <li><a href={links.termsHref} class="hover:text-brand-400">{links.terms}</a></li>
        <li><a href={links.aboutHref} class="hover:text-brand-400">{links.about}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-800/60">
    <div class="mx-auto max-w-6xl px-4 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>© {year} {SITE.name}. {links.rights}</p>
      <div class="flex items-center gap-3">
        <span class="inline-grid place-items-center w-7 h-7 rounded-full border border-slate-700 text-slate-300 font-bold">{SITE.minAge}+</span>
        <a href="https://www.begambleaware.org" rel="nofollow noopener" target="_blank" class="hover:text-slate-300">BeGambleAware.org</a>
        <a href="https://www.gamcare.org.uk" rel="nofollow noopener" target="_blank" class="hover:text-slate-300">GamCare</a>
      </div>
    </div>
  </div>
</footer>
