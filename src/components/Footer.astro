---
import { SITE, NAV } from '../config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="relative border-t border-slate-800/60 bg-slate-950/60 mt-20">
  <div class="h-px w-full bg-gradient-to-r from-gold/30 via-brand-500/50 to-brand-500/0"></div>
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2.5 font-display font-extrabold text-lg text-white">
        <Logo size={32} />
        <span><span class="text-brand-400">Mantis</span>Picks</span>
      </div>
      <p class="mt-3 text-sm text-slate-400 max-w-sm">
        {SITE.description}
      </p>
      <p class="mt-4 text-xs text-slate-500 leading-relaxed">
        {SITE.name} provides information and opinion for entertainment only. We are not a bookmaker and do not
        take bets. All odds and offers are subject to change — always check the operator's terms.
      </p>
    </div>

    <div>
      <h4 class="text-sm font-semibold text-white mb-3">Explore</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        {NAV.map((n) => <li><a href={n.href} class="hover:text-brand-400">{n.label}</a></li>)}
        <li><a href="/tools" class="hover:text-brand-400">Betting calculators</a></li>
        <li><a href="/tipsters" class="hover:text-brand-400">How we vet signals</a></li>
        <li><a href="/methodology" class="hover:text-brand-400">How we predict</a></li>
        <li><a href="/experts" class="hover:text-brand-400">Our experts</a></li>
        <li><a href="/glossary" class="hover:text-brand-400">Betting glossary</a></li>
        <li><a href="/faq" class="hover:text-brand-400">FAQ</a></li>
        <li><a href="/contact" class="hover:text-brand-400">Contact</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold text-white mb-3">By sport</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href="/football-tips" class="hover:text-brand-400">Football tips</a></li>
        <li><a href="/value" class="hover:text-brand-400">Value picks</a></li>
        <li><a href="/leagues" class="hover:text-brand-400">All leagues</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold text-white mb-3">Legal & Safety</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href="/responsible-gambling" class="hover:text-brand-400">Responsible Gambling</a></li>
        <li><a href="/privacy-policy" class="hover:text-brand-400">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-brand-400">Terms of Use</a></li>
        <li><a href="/about" class="hover:text-brand-400">About Us</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-800/60">
    <div class="mx-auto max-w-6xl px-4 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <div class="flex items-center gap-3">
        <span class="inline-grid place-items-center w-7 h-7 rounded-full border border-slate-700 text-slate-300 font-bold">{SITE.minAge}+</span>
        <a href="https://www.begambleaware.org" rel="nofollow noopener" target="_blank" class="hover:text-slate-300">BeGambleAware.org</a>
        <a href="https://www.gamcare.org.uk" rel="nofollow noopener" target="_blank" class="hover:text-slate-300">GamCare</a>
      </div>
    </div>
  </div>
</footer>
