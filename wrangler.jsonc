{
  // the site tips bot — Cloudflare Worker (cron ingestion + read API).
  // The Astro marketing site deploys separately (Cloudflare Pages); this Worker
  // is only the automated tips backend that writes to D1.
  "name": "the-site-tips-bot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // No public *.workers.dev URL and no route — the cron trigger still fires
  // server-side regardless, but the fetch/API handler is unreachable from
  // outside. Not public, on purpose.
  "workers_dev": false,

  // Cron: ingest every 30 minutes (stays within provider free quotas).
  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  // D1 binding. Create the DB then paste its id here:
  //   wrangler d1 create the-site
  //   wrangler d1 execute the-site --file db/schema.sql            (local)
  //   wrangler d1 execute the-site --remote --file db/schema.sql   (prod)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-site",
      "database_id": "1472f251-993b-4f54-b103-748ce907fbe1"
    }
  ],

  // Non-secret vars. Secrets (API_SPORTS_KEY, THE_ODDS_API_KEY) go via
  //   wrangler secret put API_SPORTS_KEY
  // and locally via .dev.vars (never committed).
  "vars": {
    // OFF: the Worker's own api-football ingestion writes to D1, which the
    // static site never reads — it was a second pull of the same fixtures the
    // GitHub pipeline already fetches for the site, burning ~48 of the 100/day
    // api-football calls. The Worker still fires the 2h pipeline trigger (that
    // path is independent of this flag). Set back to "true" only if the D1 API
    // is actually put to use.
    "INGEST_ENABLED": "false",
    "FIXTURE_LIMIT": "20"
  },

  "observability": { "enabled": true }
}
